<service>
  <id>nvidia_gpu_exporter</id>
  <name>nvidia_gpu_exporter</name>
  <description>Prometheus NVIDIA GPU exporter (nvidia-smi based), bound to tailnet 100.113.63.58:9835</description>
  <executable>%BASE%\nvidia_gpu_exporter.exe</executable>
  <arguments>--web.listen-address=100.113.63.58:9835</arguments>
  <startmode>Automatic</startmode>
  <!-- Keep this independent of the Tailscale Windows service. Tailscale MSI
       upgrades stop SCM dependents cleanly and do not restart them afterward. -->
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="5 sec"/>
  <resetfailure>1 hour</resetfailure>
  <logpath>C:\ProgramData\nvidia_gpu_exporter\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>3</keepFiles>
  </log>
</service>
