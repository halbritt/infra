#!/usr/bin/env bash
# Run the peecee streaming models under a fleet lease from proximal.
set -euo pipefail
models='.local/share/peecee-speech/0.3.0/models'
asr_en="$models/nemotron-speech-streaming-en-0.6b.q8_0.gguf"
asr_multi="$models/nemotron-3.5-asr-streaming-0.6b.q8_0.gguf"
diar="$models/diar_streaming_sortformer_4spk-v2.1.f32.gguf"

leased_ssh() {
    local job=$1
    shift
    # A PTY hangs up the foreground GPU process when the SSH session closes.
    # shellcheck disable=SC2016  # The lease runner sets GPU_FLEET_NODE in the child.
    "$HOME/git/gpu-fleet/bin/gpu-fleet-run" --model marker --job "$job" -- bash -c '
        if [[ $GPU_FLEET_NODE != peecee ]]; then
            echo "Expected a peecee GPU lease, got $GPU_FLEET_NODE." >&2
            exit 75
        fi
        exec ssh -tt -o BatchMode=yes -o LogLevel=ERROR "$@" </dev/null
    ' _ "$@"
}

# English goes to the English-only model, which made about half the errors of the
# multilingual one on far-field English. Every other language, and auto, goes to
# the multilingual model.
pick_asr() {
    case ${1,,} in
        en | en-*) asr=$asr_en ;;
        *) asr=$asr_multi ;;
    esac
}

if [[ ${1:-} == --serve && $# -le 2 && ${2:-en-US} =~ ^[A-Za-z0-9-]+$ ]]; then
    pick_asr "${2:-en-US}"
    leased_ssh peecee-speech-server -o ExitOnForwardFailure=yes \
        -L 127.0.0.1:18921:127.0.0.1:18921 peecee-wsl \
        "exec .local/bin/nemo-speech serve --asr-model $asr --diar-model $diar --backend cuda --host 127.0.0.1 --port 18921"
    exit
fi

if (( $# < 1 || $# > 2 )); then
    echo "Usage: $0 RECORDING.wav [LANGUAGE|auto]  or  $0 --serve [LANGUAGE|auto]" >&2
    exit 2
fi
audio=$1
language=${2:-auto}
if [[ ! -r $audio || ! -f $audio || ! $language =~ ^[A-Za-z0-9-]+$ ]]; then
    echo "Expected a readable WAV file and a language such as en-US or auto." >&2
    exit 2
fi

pick_asr "$language"
remote=(ssh -T -o BatchMode=yes peecee-wsl)
jobdir=$("${remote[@]}" 'mktemp -d /tmp/peecee-speech.XXXXXXXX')
[[ $jobdir =~ ^/tmp/peecee-speech\.[a-zA-Z0-9]{8}$ ]]
cleanup() {
    "${remote[@]}" "rm -f -- $jobdir/input.wav $jobdir/result.json && rmdir -- $jobdir"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
"${remote[@]}" "cat > $jobdir/input.wav" < "$audio"

command="exec .local/bin/nemo-speech transcribe $jobdir/input.wav --model $asr --diar-model $diar --language $language --stream --backend cuda --json --output $jobdir/result.json"

leased_ssh "${jobdir##*/}" peecee-wsl "$command" >&2
"${remote[@]}" "cat -- $jobdir/result.json"
