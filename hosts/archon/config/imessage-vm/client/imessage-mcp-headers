#!/bin/sh
# Claude Code MCP headersHelper for the read-only imessage-mcp server.
# Prints the bearer header from a 0600 token file so the token never sits in
# Claude's own config. Install to ~/.local/bin (mode 0755).
token_file="${IMESSAGE_MCP_TOKEN_FILE:-$HOME/.config/imessage-mcp/token}"
token=$(cat "$token_file") || exit 1
printf '{"Authorization": "Bearer %s"}\n' "$token"
