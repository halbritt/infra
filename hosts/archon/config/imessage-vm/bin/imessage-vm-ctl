#!/usr/bin/env python3
"""QMP control for the imessage-vm guest (socket /run/imessage-vm/qmp.sock).

  imessage-vm-ctl status
  imessage-vm-ctl powerdown            ACPI power button
  imessage-vm-ctl screendump OUT.png
  imessage-vm-ctl key meta_l-space     one key combo (QEMU qcodes joined by -)
  imessage-vm-ctl type 'text'          type text (US layout); \\n is Return
  imessage-vm-ctl click X Y [W H]      left click at pixel X,Y of a WxH screen (default 1920x1080)
  imessage-vm-ctl move X Y [W H]       move pointer
"""
import json
import socket
import sys
import time

SOCK = "/run/imessage-vm/qmp.sock"
PLAIN = {"-": "minus", "=": "equal", "[": "bracket_left", "]": "bracket_right", "\\": "backslash",
         ";": "semicolon", "'": "apostrophe", ",": "comma", ".": "dot", "/": "slash",
         "`": "grave_accent", " ": "spc", "\n": "ret", "\t": "tab"}
SHIFTED = {"!": "1", "@": "2", "#": "3", "$": "4", "%": "5", "^": "6", "&": "7", "*": "8",
           "(": "9", ")": "0", "_": "minus", "+": "equal", "{": "bracket_left", "}": "bracket_right",
           "|": "backslash", ":": "semicolon", '"': "apostrophe", "<": "comma", ">": "dot",
           "?": "slash", "~": "grave_accent"}


class Qmp:
    def __init__(self, path=SOCK):
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.connect(path)
        self.file = self.sock.makefile("rw")
        json.loads(self.file.readline())
        self.cmd("qmp_capabilities")

    def cmd(self, execute, **arguments):
        msg = {"execute": execute}
        if arguments:
            msg["arguments"] = arguments
        self.file.write(json.dumps(msg) + "\n")
        self.file.flush()
        while True:
            reply = json.loads(self.file.readline())
            if "return" in reply:
                return reply["return"]
            if "error" in reply:
                raise SystemExit(f"QMP error: {reply['error']}")


def qcodes_for(ch):
    if ch.isascii() and ch.isalpha():
        return (["shift", ch.lower()] if ch.isupper() else [ch])
    if ch.isdigit():
        return [ch]
    if ch in PLAIN:
        return [PLAIN[ch]]
    if ch in SHIFTED:
        return ["shift", SHIFTED[ch]]
    raise SystemExit(f"cannot type {ch!r}")


def send_combo(q, codes):
    q.cmd("send-key", keys=[{"type": "qcode", "data": c} for c in codes], **{"hold-time": 60})
    time.sleep(0.07)


def pointer(q, x, y, w, h, click):
    ax, ay = int(int(x) * 32767 / (int(w) - 1)), int(int(y) * 32767 / (int(h) - 1))
    q.cmd("input-send-event", events=[{"type": "abs", "data": {"axis": "x", "value": ax}},
                                      {"type": "abs", "data": {"axis": "y", "value": ay}}])
    if click:
        time.sleep(0.1)
        for down in (True, False):
            q.cmd("input-send-event", events=[{"type": "btn", "data": {"down": down, "button": "left"}}])
            time.sleep(0.08)


def main(argv):
    if not argv:
        raise SystemExit(__doc__)
    q = Qmp()
    op, rest = argv[0], argv[1:]
    if op == "status":
        print(json.dumps(q.cmd("query-status")))
    elif op == "powerdown":
        q.cmd("system_powerdown")
    elif op == "screendump":
        q.cmd("screendump", filename=rest[0], format="png")
    elif op == "key":
        for combo in rest:
            send_combo(q, combo.split("-"))
    elif op == "type":
        for ch in " ".join(rest).encode().decode("unicode_escape"):
            send_combo(q, qcodes_for(ch))
    elif op in ("click", "move"):
        w, h = (rest[2], rest[3]) if len(rest) >= 4 else (1920, 1080)
        pointer(q, rest[0], rest[1], w, h, op == "click")
    else:
        raise SystemExit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
