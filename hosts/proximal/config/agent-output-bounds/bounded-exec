#!/usr/bin/env python3
"""Wrap a command so oversized stdout/stderr is spooled to ~/.cache/bounded-output/
while preserving exact exit codes, head, middle error/diagnostic lines, and tail.
"""

from __future__ import annotations

from datetime import datetime, timezone
import errno
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile


DIAG_RE = re.compile(r"(error|panic|fatal|fail|exception|traceback|assert|exit code|signal|refused|stack)", re.I)


def is_truthy(raw: str | None) -> bool:
    return (raw or "").strip().lower() in ("1", "true", "yes")


def parse_positive_int(raw: str | None, default: int) -> int:
    if raw is None or not raw.strip():
        return default
    try:
        val = int(raw.strip())
        return val if val >= 0 else default
    except ValueError:
        return default


def resolve_spool_dir() -> Path:
    override = os.environ.get("BOUNDED_EXEC_OUTPUT_DIR", "").strip()
    if override and os.path.isabs(override):
        return Path(override)
    cache = os.environ.get("XDG_CACHE_HOME", "").strip()
    if cache and os.path.isabs(cache):
        return Path(cache) / "bounded-output"
    return Path.home() / ".cache" / "bounded-output"


def spool_raw(raw: bytes, spool_dir: Path) -> Path:
    spool_dir.mkdir(parents=True, exist_ok=True)
    if spool_dir.is_symlink():
        raise RuntimeError(f"refusing symlink spool dir: {spool_dir}")
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    final_path = spool_dir / f"{stamp}-{os.getpid()}.log"
    fd, tmp_name = tempfile.mkstemp(prefix=".bounded-", dir=str(spool_dir))
    tmp_path = Path(tmp_name)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "wb") as handle:
            handle.write(raw)
        os.replace(tmp_path, final_path)
    except Exception:
        tmp_path.unlink(missing_ok=True)
        raise
    return final_path


def split_line_spans(buf: bytes) -> list[tuple[int, int]]:
    """Return (start, end_incl_nl) byte spans for each line in buf."""
    spans: list[tuple[int, int]] = []
    pos = 0
    n = len(buf)
    while pos < n:
        nl = buf.find(b"\n", pos)
        if nl == -1:
            spans.append((pos, n))
            break
        spans.append((pos, nl + 1))
        pos = nl + 1
    return spans


def truncate_prefix_utf8(text: str, max_bytes: int) -> tuple[str, int]:
    raw = text.encode("utf-8", errors="replace")
    if max_bytes <= 0 or not raw:
        return "", 0
    if len(raw) <= max_bytes:
        return raw.decode("utf-8", errors="replace"), len(raw)
    cut = max_bytes
    while cut > 0 and (raw[cut] & 0xC0) == 0x80:
        cut -= 1
    if cut == 0:
        return "", 0
    nl = raw.rfind(b"\n", max(cut // 2, cut - 256), cut)
    if nl > 0:
        cut = nl + 1
    return raw[:cut].decode("utf-8", errors="replace"), cut


def truncate_suffix_utf8(text: str, max_bytes: int) -> tuple[str, int]:
    raw = text.encode("utf-8", errors="replace")
    total = len(raw)
    if max_bytes <= 0 or not raw:
        return "", total
    if total <= max_bytes:
        return raw.decode("utf-8", errors="replace"), 0
    start = total - max_bytes
    while start < total and (raw[start] & 0xC0) == 0x80:
        start += 1
    if start >= total:
        return "", total
    nl = raw.find(b"\n", start, min(total, start + min(256, (total - start) // 2)))
    if nl >= 0 and nl + 1 < total:
        start = nl + 1
    return raw[start:].decode("utf-8", errors="replace"), start


def select_head_and_tail(
    raw_buf: bytes,
    spans: list[tuple[int, int]],
    head_budget: int,
    tail_budget: int,
    head_line_cap: int,
    tail_line_cap: int,
) -> tuple[str, int, str, int]:
    total_lines = len(spans)
    if head_line_cap > 0 and total_lines > 0:
        line_head_end = spans[min(head_line_cap, total_lines) - 1][1]
    else:
        line_head_end = 0 if head_line_cap == 0 else len(raw_buf)
    head_candidate = raw_buf[:line_head_end].decode("utf-8", errors="replace")
    head, head_end = truncate_prefix_utf8(head_candidate, head_budget)

    rem_buf = raw_buf[head_end:]
    rem_spans = split_line_spans(rem_buf)
    if tail_line_cap > 0 and rem_spans:
        line_tail_rel = rem_spans[-min(tail_line_cap, len(rem_spans))][0]
    else:
        line_tail_rel = len(rem_buf) if tail_line_cap == 0 else 0
    tail_candidate = rem_buf[line_tail_rel:].decode("utf-8", errors="replace")
    tail, tail_in_cand = truncate_suffix_utf8(tail_candidate, tail_budget)
    tail_start = head_end + line_tail_rel + tail_in_cand
    return head, head_end, tail, tail_start


def clamp_utf8_bytes(text: str, max_bytes: int) -> str:
    if max_bytes <= 0:
        return text
    encoded = text.encode("utf-8", errors="replace")
    if len(encoded) <= max_bytes:
        return text
    if max_bytes == 1:
        return "\n"
    prefix, _ = truncate_prefix_utf8(text, max_bytes - 1)
    if not prefix.endswith("\n"):
        prefix += "\n"
    return prefix


def compact_pointer_line(total_bytes: int, total_lines: int, log_path: Path, exit_code: int) -> str:
    if exit_code != 0:
        return f"[bounded-exec exit_code={exit_code}; full output ({total_bytes}B/{total_lines}L): {log_path}]\n"
    return f"[... full output ({total_bytes} bytes, {total_lines} lines): {log_path} ...]\n"


def build_bounded_excerpt(
    raw: bytes, max_bytes: int, max_lines: int, log_path: Path, exit_code: int
) -> str:
    text = raw.decode("utf-8", errors="replace")
    raw_buf = text.encode("utf-8")
    total_bytes = len(raw)
    total_buf_bytes = len(raw_buf)
    spans = split_line_spans(raw_buf)
    total_lines = len(spans)

    if max_lines == 1:
        return clamp_utf8_bytes(compact_pointer_line(total_bytes, total_lines, log_path, exit_code), max_bytes)

    header = f"[bounded-exec] exit_code={exit_code}\n" if exit_code != 0 else ""
    diag_header = "[... diagnostic lines from omitted middle ...]\n"
    footer_template = (
        f"[... omitted {total_bytes} of {total_bytes} bytes "
        f"({total_lines} of {total_lines} lines); full output: {log_path} ...]\n"
    )
    reserve = (
        len(header.encode("utf-8"))
        + len(diag_header.encode("utf-8"))
        + len(footer_template.encode("utf-8"))
        + 4
    )
    if max_bytes > 0 and max_bytes <= reserve + 32:
        compact = f"{header}[... full output ({total_bytes} bytes, {total_lines} lines): {log_path} ...]\n"
        return clamp_utf8_bytes(compact, max_bytes)

    if max_bytes > 0:
        budget = max_bytes - reserve
        head_budget = budget * 35 // 100
        diag_budget = budget * 30 // 100
        tail_budget = budget - head_budget - diag_budget
    else:
        head_budget = total_buf_bytes
        diag_budget = total_buf_bytes
        tail_budget = total_buf_bytes

    cap_lines = max_lines > 0
    if cap_lines:
        base_framing = (1 if header else 0) + 1
        avail_lines = max_lines - base_framing
        if avail_lines <= 0:
            head_line_cap, diag_line_cap, tail_line_cap = 0, 0, 0
        elif avail_lines == 1:
            head_line_cap, diag_line_cap, tail_line_cap = 1, 0, 0
        elif avail_lines == 2:
            head_line_cap, diag_line_cap, tail_line_cap = 1, 0, 1
        else:
            # Reserve 1 line for diag_header when diagnostics may be included.
            line_budget = avail_lines - 1
            if line_budget == 2:
                head_line_cap, diag_line_cap, tail_line_cap = 1, 1, 0
            else:
                head_line_cap = max(1, line_budget * 35 // 100)
                diag_line_cap = max(1, line_budget * 30 // 100)
                tail_line_cap = line_budget - head_line_cap - diag_line_cap
                if tail_line_cap < 1:
                    if head_line_cap > 1:
                        head_line_cap -= 1
                    elif diag_line_cap > 1:
                        diag_line_cap -= 1
                    tail_line_cap = 1
    else:
        head_line_cap = total_lines
        diag_line_cap = total_lines
        tail_line_cap = total_lines

    head, head_end, tail, tail_start = select_head_and_tail(
        raw_buf, spans, head_budget, tail_budget, head_line_cap, tail_line_cap
    )
    middle = raw_buf[head_end:tail_start].decode("utf-8", errors="replace")

    diags: list[str] = []
    seen: set[str] = set()
    diag_used = 0
    for line in middle.splitlines():
        if len(diags) >= diag_line_cap:
            break
        clean = line.rstrip("\r")
        trimmed = clean.strip()
        if not trimmed or not DIAG_RE.search(trimmed) or trimmed in seen:
            continue
        seen.add(trimmed)
        sep = 1 if diags else 0
        rem = diag_budget - diag_used - sep
        if rem <= 0:
            break
        bounded_line, bounded_len = truncate_prefix_utf8(clean, rem)
        if not bounded_line:
            break
        diags.append(bounded_line)
        diag_used += sep + bounded_len

    if not diags and (diag_budget > 0 or diag_line_cap > 0):
        extra_head_bytes = diag_budget // 2
        extra_tail_bytes = diag_budget - extra_head_bytes
        if cap_lines and diag_line_cap > 0:
            reclaim_lines = diag_line_cap + 1
            extra_head_lines = reclaim_lines // 2
            extra_tail_lines = reclaim_lines - extra_head_lines
        else:
            extra_head_lines = 0
            extra_tail_lines = 0
        head, head_end, tail, tail_start = select_head_and_tail(
            raw_buf,
            spans,
            head_budget + extra_head_bytes,
            tail_budget + extra_tail_bytes,
            head_line_cap + extra_head_lines,
            tail_line_cap + extra_tail_lines,
        )

    middle_buf = raw_buf[head_end:tail_start]
    middle_bytes = len(middle_buf)
    omitted_bytes = max(0, middle_bytes - diag_used)
    if total_buf_bytes != total_bytes and total_buf_bytes > 0:
        # Preserve raw byte scale when invalid UTF-8 bytes were replaced.
        omitted_bytes = min(total_bytes, max(0, total_bytes - head_end - diag_used - (total_buf_bytes - tail_start)))
    middle_lines = len(split_line_spans(middle_buf))
    omitted_lines = max(0, middle_lines - len(diags))

    if omitted_bytes > 0 and omitted_lines > 0 and cap_lines and total_lines > 1:
        omit_desc = f"omitted {omitted_bytes} of {total_bytes} bytes ({omitted_lines} of {total_lines} lines)"
    elif omitted_bytes > 0:
        omit_desc = f"omitted {omitted_bytes} of {total_bytes} bytes"
    elif omitted_lines > 0:
        omit_desc = f"omitted {omitted_lines} of {total_lines} lines"
    else:
        omit_desc = f"{total_bytes} bytes"

    parts: list[str] = []
    if header:
        parts.append(header)
    if head:
        parts.append(head)
        if not head.endswith("\n"):
            parts.append("\n")
    if diags:
        parts.append(diag_header)
        parts.append("\n".join(diags))
        parts.append("\n")
    parts.append(f"[... {omit_desc}; full output: {log_path} ...]\n")
    if tail:
        parts.append(tail)
        if not tail.endswith("\n"):
            parts.append("\n")
    assembled = "".join(parts)
    if max_lines > 0 and len(assembled.splitlines()) > max_lines:
        footer_line = f"[... full output ({total_bytes} bytes, {total_lines} lines): {log_path} ...]\n"
        lines = assembled.splitlines(keepends=True)
        assembled = "".join(lines[: max_lines - 1]) + footer_line
        if len(assembled.splitlines()) > max_lines:
            assembled = (header + footer_line) if (header and max_lines >= 2) else footer_line
    return clamp_utf8_bytes(assembled, max_bytes)


def main(argv: list[str] | None = None) -> int:
    args = sys.argv[1:] if argv is None else argv
    if args and args[0] == "--":
        args = args[1:]
    if not args:
        sys.stderr.write("Usage: bounded-exec [--] COMMAND [ARGS...]\n")
        return 2

    raw_mode = is_truthy(os.environ.get("BOUNDED_EXEC_RAW"))
    max_bytes = parse_positive_int(os.environ.get("BOUNDED_EXEC_MAX_BYTES"), 16384)
    max_lines_env = os.environ.get("BOUNDED_EXEC_MAX_LINES")
    max_lines = parse_positive_int(max_lines_env, 300)
    explicit_positive_max_lines = (
        max_lines_env is not None and max_lines_env.strip() != "" and max_lines > 0
    )
    if max_bytes == 0 and not explicit_positive_max_lines:
        raw_mode = True

    try:
        proc = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    except FileNotFoundError:
        sys.stderr.write(f"bounded-exec: {args[0]}: not found\n")
        return 127
    except PermissionError:
        sys.stderr.write(f"bounded-exec: {args[0]}: permission denied\n")
        return 126
    except OSError as exc:
        sys.stderr.write(f"bounded-exec: {args[0]}: {exc.strerror or exc}\n")
        if exc.errno in (errno.ENOENT, errno.ENOTDIR):
            return 127
        return 126

    exit_code = proc.returncode
    if exit_code < 0:
        exit_code = 128 + abs(exit_code)

    combined = proc.stdout + proc.stderr
    line_count = len(split_line_spans(combined))
    over_bytes = max_bytes > 0 and len(combined) > max_bytes
    over_lines = max_lines > 0 and line_count > max_lines

    if raw_mode or (not over_bytes and not over_lines):
        if proc.stdout:
            sys.stdout.buffer.write(proc.stdout)
            sys.stdout.buffer.flush()
        if proc.stderr:
            sys.stderr.buffer.write(proc.stderr)
            sys.stderr.buffer.flush()
        return exit_code

    log_path = spool_raw(combined, resolve_spool_dir())
    excerpt = build_bounded_excerpt(combined, max_bytes, max_lines, log_path, exit_code)
    dest = sys.stderr if (not proc.stdout and proc.stderr) else sys.stdout
    dest.write(excerpt)
    if not excerpt.endswith("\n") and (max_bytes <= 0 or len(excerpt.encode("utf-8")) < max_bytes):
        dest.write("\n")
    dest.flush()
    return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
