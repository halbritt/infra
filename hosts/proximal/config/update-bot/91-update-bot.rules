// Fixed OS and native gateway actions; no caller-supplied privileged commands.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        subject.user === "halbritt" &&
        (action.lookup("unit") === "update-bot-os.service" ||
         action.lookup("unit") === "update-bot-hermes-activate.service") &&
        action.lookup("verb") === "start") {
        return polkit.Result.YES;
    }
});
