+@dataclass
+class QueuedMessage:
+    """Typed message queued for serial CLI consumption with session pinning.
+
+    Ensures that a message queued for a specific native conversation ID is only
+    admitted if the CLI is still on that session when process_loop dequeues it.
+    If the conversation has changed (e.g. via /resume), the message is refused
+    and discarded with an observable status and warning.
+
+    Status transitions:
+      - "pending": Enqueued in _pending_input, waiting to be dequeued.
+      - "refused": Dequeued when active session != expected_session_id; discarded.
+      - "admitted": Dequeued and verified against active session; admitted to chat.
+        (Note: "admitted" indicates dequeued/admitted to the chat execution pipeline,
+        NOT that execution has completed or succeeded).
+    """
+
+    text: str
+    expected_session_id: str | None = None
+    role: str = "user"
+    source: str = ""
