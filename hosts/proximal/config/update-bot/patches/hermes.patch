+        self.assertEqual(cli._active_delivery_id, "cairn-del-uuid-5678")
+        self.assertIsNotNone(cli._active_turn_id)
+
+    def test_production_dequeue_clears_active_request_for_normal_input(self):
+        """Production seam: normal prompt input sets _active_request_id to None."""
+        cli = _create_cli(session_id="session-normal")
+        cli._active_request_id = "stale-request-id"
+
+        result = cli._dequeue_pending_input("normal user prompt")
+        self.assertEqual(result, "normal user prompt")
+        self.assertIsNone(cli._active_request_id)
+        self.assertIsNone(cli._active_delivery_id)
+        self.assertIsNotNone(cli._active_turn_id)
+
+    def test_process_loop_clears_active_request_id_in_finally(self):
+        """End-to-end loop: _active_request_id is cleared after turn completes."""
+        cli = _create_cli(session_id="session-loop-clean")
+        qm = QueuedMessage(
+            text="task prompt",
+            expected_session_id="session-loop-clean",
+            request_id="req-clean-1",
+        )
+
+        seen_active_in_chat = []
+
+        def mock_chat(user_input, images=None, voice_input=False):
+            seen_active_in_chat.append(cli._active_request_id)
+            cli._should_exit = True
+
+        cli.chat = mock_chat
+        cli._pending_input.put(qm)
+        cli._tui_process_loop()
+
+        self.assertEqual(seen_active_in_chat, ["req-clean-1"])
+        self.assertIsNone(cli._active_request_id)
+        self.assertIsNone(cli._active_turn_id)
+
+
+    def test_process_registry_attaches_request_id_from_context(self):
+        """ProcessRegistry.spawn_local captures active request_id from contextvar."""
+        from tools.approval import set_current_request_id, get_current_request_id
+        from tools.process_registry import ProcessRegistry
+
+        reg = ProcessRegistry()
+        token = set_current_request_id("test-cairn-req-99")
+        try:
+            sess = reg.spawn_local("echo hello")
+            self.assertEqual(sess.request_id, "test-cairn-req-99")
+            listed = reg.list_sessions()
+            matching = [p for p in listed if p["session_id"] == sess.id]
+            self.assertEqual(len(matching), 1)
+            self.assertEqual(matching[0]["request_id"], "test-cairn-req-99")
+        finally:
+            set_current_request_id("")
+            reg.kill_all()
+
+    def test_process_registry_attaches_turn_id_from_context(self):
+        """ProcessRegistry.spawn_local captures active turn_id from contextvar."""
+        from tools.approval import set_current_turn_id, get_current_turn_id
+        from tools.process_registry import ProcessRegistry
+
+        reg = ProcessRegistry()
+        token = set_current_turn_id("test-turn-uuid-42")
+        try:
+            sess = reg.spawn_local("echo hello-turn")
