index 0000000..e474b9e
--- /dev/null
+++ b/packages/opencode/test/session/admission.test.ts
@@ -0,0 +1,156 @@
+import { expect, test } from "bun:test"
+import { Deferred, Effect, Fiber, Scope } from "effect"
+import { SessionAdmission } from "../../src/session/admission"
+
+const run = (work: Effect.Effect<void, never, Scope.Scope>) => Effect.runPromise(Effect.scoped(work))
+
+test("idle admission refuses existing owner work and simultaneous requests", () =>
+  run(
+    Effect.gen(function* () {
+      const admission = SessionAdmission.make(yield* Scope.Scope, crypto.randomUUID())
+      const entered = yield* Deferred.make<void>()
+      const done = yield* Deferred.make<void>()
+      const owner = yield* admission
+        .owner("session", Deferred.succeed(entered, undefined).pipe(Effect.andThen(Deferred.await(done))))
+        .pipe(Effect.forkChild)
+      yield* Deferred.await(entered)
+      expect(yield* admission.start("session", "wake", "body", Effect.die("must not execute"))).toBe("busy")
+      yield* Deferred.succeed(done, undefined)
+      yield* Fiber.join(owner)
+      const finished = yield* Deferred.make<void>()
+      const statuses = yield* Effect.all(
+        [
+          admission.start("session", "a", "a", Deferred.await(finished)),
+          admission.start("session", "b", "b", Deferred.await(finished)),
+        ],
+        { concurrency: "unbounded" },
+      )
+      expect(statuses.filter((status) => status === "accepted")).toHaveLength(1)
+      expect(statuses.filter((status) => status === "busy")).toHaveLength(1)
+      yield* Deferred.succeed(finished, undefined)
+    }),
+  ))
+
+test("request retries never rerun work and changed payload conflicts", () =>
+  run(
+    Effect.gen(function* () {
+      const admission = SessionAdmission.make(yield* Scope.Scope, crypto.randomUUID())
+      const started = yield* Deferred.make<void>()
+      const done = yield* Deferred.make<void>()
+      const work = Deferred.succeed(started, undefined).pipe(Effect.andThen(Deferred.await(done)))
+      expect(yield* admission.start("session", "request", "body", work)).toBe("accepted")
+      yield* Deferred.await(started)
+      expect(yield* admission.start("session", "request", "body", Effect.die("duplicate"))).toBe("accepted")
+      expect(yield* admission.start("session", "request", "different", work)).toBe("conflict")
+      yield* Deferred.succeed(done, undefined)
+      yield* admission.owner("session", Effect.void)
+      expect(yield* admission.start("session", "request", "body", Effect.die("duplicate"))).toBe("completed")
+    }),
+  ))
+
+test("exact cancellation holds owner input until tool finalizers complete", () =>
+  run(
+    Effect.gen(function* () {
+      const admission = SessionAdmission.make(yield* Scope.Scope, crypto.randomUUID())
+      const started = yield* Deferred.make<void>()
+      const cleaning = yield* Deferred.make<void>()
+      const cleanupDone = yield* Deferred.make<void>()
+      const ownerStarted = yield* Deferred.make<void>()
+      const work = Deferred.succeed(started, undefined).pipe(
+        Effect.andThen(Effect.never),
+        Effect.ensuring(Deferred.succeed(cleaning, undefined).pipe(Effect.andThen(Deferred.await(cleanupDone)))),
+      )
+      expect(yield* admission.start("session", "wake", "body", work)).toBe("accepted")
+      yield* Deferred.await(started)
+      expect(yield* admission.cancel("session", "stale", Effect.die("wrong cleanup"))).toBe(false)
+      const owner = yield* admission.owner("session", Deferred.succeed(ownerStarted, undefined)).pipe(Effect.forkChild)
+      const cancel = yield* admission.cancel("session", "wake", Effect.void).pipe(Effect.forkChild)
+      yield* Deferred.await(cleaning)
+      expect(yield* Deferred.isDone(ownerStarted)).toBe(false)
+      expect(yield* admission.start("session", "other", "body", Effect.void)).toBe("busy")
+      yield* Deferred.succeed(cleanupDone, undefined)
+      expect(yield* Fiber.join(cancel)).toBe(true)
+      yield* Fiber.join(owner)
+      expect(yield* admission.start("session", "wake", "body", Effect.die("duplicate"))).toBe("cancelled")
+      const next = yield* Deferred.make<void>()
+      expect(yield* admission.start("session", "next", "body", Deferred.await(next))).toBe("accepted")
+      expect(yield* admission.cancel("session", "wake", Effect.die("must not cancel next"))).toBe(false)
+      yield* Deferred.succeed(next, undefined)
+    }),
+  ))
+
+test("ordinary owners still overlap for native steering", () =>
+  run(
+    Effect.gen(function* () {
+      const admission = SessionAdmission.make(yield* Scope.Scope, crypto.randomUUID())
+      const both = yield* Deferred.make<void>()
+      let count = 0
+      const work = Effect.gen(function* () {
+        count += 1
+        if (count === 2) yield* Deferred.succeed(both, undefined)
+        yield* Deferred.await(both)
+      })
+      yield* Effect.all([admission.owner("session", work), admission.owner("session", work)], {
+        concurrency: "unbounded",
+      })
+      expect(count).toBe(2)
+    }),
+  ))
+
+test("legacy abort cannot wait behind an exclusive request and cancel later work", () =>
+  run(
+    Effect.gen(function* () {
+      const admission = SessionAdmission.make(yield* Scope.Scope, crypto.randomUUID())
+      const finish = yield* Deferred.make<void>()
+      expect(yield* admission.start("session", "wake", "body", Deferred.await(finish))).toBe("accepted")
+      const abort = yield* admission.tryOwner("session", Effect.die("legacy abort ran during exclusive work"))
+      expect(abort.status).toBe("busy")
+      yield* Deferred.succeed(finish, undefined)
+      const finished = yield* admission.owner("session", Effect.void)
+      expect(finished).toBeUndefined()
+
+      const entered = yield* Deferred.make<void>()
+      const release = yield* Deferred.make<void>()
+      const owner = yield* admission.tryOwner(
+        "session",
+        Deferred.succeed(entered, undefined).pipe(Effect.andThen(Deferred.await(release))),
+      ).pipe(Effect.forkChild)
+      yield* Deferred.await(entered)
+      expect(yield* admission.start("session", "next", "body", Effect.die("must not start"))).toBe("busy")
+      yield* Deferred.succeed(release, undefined)
+      expect((yield* Fiber.join(owner)).status).toBe("completed")
+    }),
+  ))
+
+test("instance teardown is refused while a request or owner runs and seals old admission", () =>
+  run(
+    Effect.gen(function* () {
+      const directory = crypto.randomUUID()
+      const admission = SessionAdmission.make(yield* Scope.Scope, directory)
+      const finish = yield* Deferred.make<void>()
+      expect(yield* admission.start("session", "wake", "body", Deferred.await(finish))).toBe("accepted")
+      expect(SessionAdmission.beginDispose(directory)).toBe(false)
+      yield* Deferred.succeed(finish, undefined)
+      yield* admission.owner("session", Effect.void)
+
+      const enteredOwner = yield* Deferred.make<void>()
+      const releaseOwner = yield* Deferred.make<void>()
+      const owner = yield* admission.owner(
+        "session",
+        Deferred.succeed(enteredOwner, undefined).pipe(Effect.andThen(Deferred.await(releaseOwner))),
+      ).pipe(Effect.forkChild)
+      yield* Deferred.await(enteredOwner)
+      expect(SessionAdmission.beginDispose(directory)).toBe(false)
+      yield* Deferred.succeed(releaseOwner, undefined)
+      yield* Fiber.join(owner)
+
+      expect(SessionAdmission.beginDispose(directory)).toBe(true)
+      expect(yield* admission.start("session", "later", "body", Effect.die("started during disposal"))).toBe("busy")
+      expect((yield* admission.tryOwner("session", Effect.die("owner during disposal"))).status).toBe("busy")
+      SessionAdmission.finishDispose(directory)
+      SessionAdmission.openInstance(directory)
+      expect(yield* admission.start("session", "stale", "body", Effect.die("stale instance ran"))).toBe("busy")
+      const next = SessionAdmission.make(yield* Scope.Scope, directory)
+      expect(yield* next.start("session", "fresh", "body", Effect.void)).toBe("accepted")
+    }),
+  ))
