diff --git a/packages/opencode/src/session/admission.ts b/packages/opencode/src/session/admission.ts
new file mode 100644
index 0000000..06e5bbd
--- /dev/null
+++ b/packages/opencode/src/session/admission.ts
@@ -0,0 +1,183 @@
+import { Deferred, Effect, Fiber, Scope } from "effect"
+
+type DirectoryGate = {
+  epoch: number
+  phase: "open" | "disposing" | "closed"
+  exclusive: number
+  owners: number
+}
+
+// The runner and its instance are process-local. This gate is shared by native
+// admission and instance teardown, so neither can pass a separate busy check
+// and then race the other before changing state.
+const directories = new Map<string, DirectoryGate>()
+
+const gate = (directory: string) => {
+  const existing = directories.get(directory)
+  if (existing) return existing
+  const created: DirectoryGate = { epoch: 0, phase: "open", exclusive: 0, owners: 0 }
+  directories.set(directory, created)
+  return created
+}
+
+export const openInstance = (directory: string) => {
+  const current = gate(directory)
+  if (current.phase === "disposing") throw new Error("instance disposal is in progress")
+  if (current.phase === "closed") current.phase = "open"
+}
+
+export const beginDispose = (directory: string) => {
+  const current = gate(directory)
+  if (current.phase !== "open" || current.exclusive > 0 || current.owners > 0) return false
+  current.phase = "disposing"
+  return true
+}
+
+export const finishDispose = (directory: string) => {
+  const current = gate(directory)
+  current.phase = "closed"
+  current.epoch += 1
+}
+
+// This owner spans prompt preparation, the native run, and cancellation cleanup.
+// Owner prompts retain their usual steering behavior; only automated work is exclusive.
+export const make = (scope: Scope.Scope, directory: string) => {
+  const directoryGate = gate(directory)
+  const epoch = directoryGate.epoch
+  const owners = new Map<string, number>()
+  const active = new Map<string, Request>()
+  const requests = new Map<string, Map<string, Request>>()
+
+  type Request = {
+    requestID: string
+    fingerprint: string
+    done: Deferred.Deferred<void>
+    ready: Deferred.Deferred<Fiber.Fiber<void>>
+    status: "accepted" | "completed" | "cancelled" | "failed"
+    stopping: boolean
+  }
+
+  const release = (sessionID: string, request: Request) =>
+    Effect.gen(function* () {
+      if (active.get(sessionID) === request) {
+        active.delete(sessionID)
+        directoryGate.exclusive -= 1
+      }
+      yield* Deferred.succeed(request.done, undefined)
+    })
+
+  const available = () => directoryGate.phase === "open" && directoryGate.epoch === epoch
+
+  const owner = <A, E, R>(sessionID: string, work: Effect.Effect<A, E, R>) =>
+    Effect.acquireUseRelease(
+      Effect.sync(() => {
+        if (!available()) throw new Error("instance is unavailable for owner work")
+        owners.set(sessionID, (owners.get(sessionID) ?? 0) + 1)
+        directoryGate.owners += 1
+        return active.get(sessionID)
+      }),
+      (request) => (request ? Deferred.await(request.done).pipe(Effect.andThen(work)) : work),
+      () =>
+        Effect.sync(() => {
+          const count = owners.get(sessionID)! - 1
+          if (count === 0) owners.delete(sessionID)
+          else owners.set(sessionID, count)
+          directoryGate.owners -= 1
+        }),
+    )
+
+  // Abort is different from ordinary owner steering: waiting and then aborting
+  // could cancel a later owner's turn. Reserve the owner slot immediately or
+  // refuse while an exclusive request holds it.
+  const tryOwner = <A, E, R>(sessionID: string, work: Effect.Effect<A, E, R>) =>
+    Effect.acquireUseRelease(
+      Effect.sync(() => {
+        if (!available() || active.has(sessionID)) return false
+        owners.set(sessionID, (owners.get(sessionID) ?? 0) + 1)
+        directoryGate.owners += 1
+        return true
+      }),
+      (admitted): Effect.Effect<{ status: "completed"; value: A } | { status: "busy" }, E, R> =>
+        admitted
+          ? Effect.map(work, (value) => ({ status: "completed" as const, value }))
+          : Effect.succeed({ status: "busy" as const }),
+      (admitted) =>
+        Effect.sync(() => {
+          if (!admitted) return
+          const count = owners.get(sessionID)! - 1
+          if (count === 0) owners.delete(sessionID)
+          else owners.set(sessionID, count)
+          directoryGate.owners -= 1
+        }),
+    )
+
+  const start = (
+    sessionID: string,
+    requestID: string,
+    fingerprint: string,
+    work: Effect.Effect<void>,
+    idle = Effect.succeed(true),
+  ) =>
+    Effect.uninterruptible(
+      Effect.gen(function* () {
+        const previous = requests.get(sessionID)?.get(requestID)
+        if (previous) return previous.fingerprint === fingerprint ? previous.status : ("conflict" as const)
+        if (!available() || active.has(sessionID) || owners.has(sessionID)) return "busy" as const
+        const request: Request = {
+          requestID,
+          fingerprint,
+          done: Deferred.makeUnsafe<void>(),
+          ready: Deferred.makeUnsafe<Fiber.Fiber<void>>(),
+          status: "accepted",
+          stopping: false,
+        }
+        // No suspension between checking ownership and reserving it.
+        active.set(sessionID, request)
+        directoryGate.exclusive += 1
+        if (!(yield* idle)) {
+          yield* release(sessionID, request)
+          return "busy" as const
+        }
+        const history = requests.get(sessionID) ?? new Map<string, Request>()
+        history.set(requestID, request)
+        requests.set(sessionID, history)
+        const fiber = yield* work.pipe(
+          Effect.interruptible,
+          Effect.onExit((exit) =>
+            Effect.gen(function* () {
+              if (request.stopping) return
+              request.status = exit._tag === "Success" ? "completed" : "failed"
+              yield* release(sessionID, request)
+            }),
+          ),
+          Effect.forkIn(scope),
+        )
+        yield* Deferred.succeed(request.ready, fiber)
+        return "accepted" as const
+      }),
+    )
+
+  const cancel = (sessionID: string, requestID: string, cleanup: Effect.Effect<void>) =>
+    Effect.uninterruptible(
+      Effect.gen(function* () {
+        const request = active.get(sessionID)
+        if (!request || request.requestID !== requestID) return false
+        if (request.stopping) {
+          yield* Deferred.await(request.done)
+          return true
+        }
+        request.stopping = true
+        const fiber = yield* Deferred.await(request.ready)
+        // Do not release ownership until the native runner and its tools have stopped.
+        yield* cleanup
+        yield* Fiber.interrupt(fiber)
+        request.status = "cancelled"
+        yield* release(sessionID, request)
+        return true
+      }),
+    )
+
+  return { owner, tryOwner, start, cancel }
+}
+
+export * as SessionAdmission from "./admission"
