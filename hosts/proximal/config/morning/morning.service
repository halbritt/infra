[Unit]
Description=Morning household routine and spoken-code sign-in
After=network-online.target announce.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/git/announce
ExecStart=/usr/bin/python3 -m morning_app.web
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
