[Unit]
Description=Build and fast-forward llama.cpp after upstream validation
Documentation=https://github.com/ggml-org/llama.cpp
ConditionPathIsDirectory=/home/halbritt/git/llama.cpp

[Service]
Type=oneshot
# CMake's enable_language(CUDA) resolves nvcc from PATH (or CUDACXX). The systemd
# *user* manager environment does not inherit ~/.profile, so /usr/local/cuda/bin is
# absent there and every run died at configure with "No CMAKE_CUDA_COMPILER could be
# found" (20/20 runs, 2026-07-31 → 2026-09-26). Set both explicitly — same PATH
# pattern the llama-27b.service unit already uses.
Environment=PATH=/usr/local/cuda/bin:/home/halbritt/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CUDACXX=/usr/local/cuda/bin/nvcc
ExecStart=/home/halbritt/.local/bin/llama-cpp-update
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
TimeoutStartSec=2h
