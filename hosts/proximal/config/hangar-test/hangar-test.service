[Unit]
Description=Hangar isolated evaluation instance (Docker Compose)
Requires=docker.service
After=docker.service network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=halbritt
Group=halbritt
SupplementaryGroups=docker
WorkingDirectory=/home/halbritt/services/hangar-test
ExecStartPre=/usr/bin/docker compose --env-file hangar.env config --quiet
ExecStart=/usr/bin/docker compose --env-file hangar.env up -d --pull never
ExecReload=/usr/bin/docker compose --env-file hangar.env up -d --force-recreate --pull never
ExecStop=/usr/bin/docker compose --env-file hangar.env stop
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
