[Unit]
Description=Resync striatum-lane Claude OAuth credential from the operator (rotating-token survival)
Documentation=https://github.com/halbritt/striatum/issues/583
Documentation=file:/home/halbritt/git/infra/hosts/proximal/config/striatum/README.md
# Ordering-after striatumd is cosmetic (the resync is independent of the daemon),
# but it keeps journal timelines readable.
After=striatumd.service

[Service]
Type=oneshot
# Runs as root (no User=): must read halbritt's 0600 ~/.claude/.credentials.json
# and write striatum-lane's copy with a chown — a single non-root UID cannot do
# both. The script itself is the only privileged surface; keep it root-owned and
# not group/other-writable in /usr/local/bin.
ExecStart=/usr/local/bin/striatum-lane-cred-resync.sh
# Polite background citizen on the shared box.
Nice=10
