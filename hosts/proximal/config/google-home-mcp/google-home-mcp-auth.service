[Unit]
Description=Google Home OAuth callback for the doorbell recognition test

[Service]
Type=simple
WorkingDirectory=%h/.local/share/google-home-mcp
ExecStart=%h/.local/share/google-home-mcp/.venv/bin/python %h/.local/share/google-home-mcp/home_mcp.py auth --seconds 3600
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/google-home-mcp
TimeoutStopSec=5
