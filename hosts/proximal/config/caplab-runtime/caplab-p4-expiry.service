[Unit]
Description=Disable CAPLAB P4 campaign access before authorization expiry
After=postgresql.service garage.service
Wants=postgresql.service garage.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/caplab-hostctl disable
Restart=on-failure
RestartSec=60
TimeoutStartSec=120
UMask=0077
