[Unit]
Description=Run plant-praxis-bridge hourly
Documentation=https://github.com/halbritt/proximal/tree/master/hosts/proximal/config/plant-praxis-bridge

[Timer]
OnBootSec=10min
OnUnitActiveSec=1h
# Spread off the top of the hour so it doesn't stampede other timers.
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
