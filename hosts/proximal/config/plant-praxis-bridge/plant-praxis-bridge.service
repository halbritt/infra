[Unit]
Description=plant-praxis-bridge — file a Praxis reminder when a plant needs water
Documentation=https://github.com/halbritt/infra/tree/master/hosts/proximal/config/plant-praxis-bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# VictoriaMetrics read creds + retained InfluxDB rollback creds (proximal-local),
# plus the harm Plane API key (already on box).
# Leading '-' on the plane env: missing file => no PLANE_API_KEY => create fails
# loudly rather than the unit refusing to start.
EnvironmentFile=%h/.config/plant-praxis-bridge.env
EnvironmentFile=-%h/.config/plane/harm-mcp.env
ExecStart=/usr/bin/python3 %h/git/infra/hosts/proximal/config/plant-praxis-bridge/plant_praxis_bridge.py
