# Install root:root 0600; reuse the existing read-only exporter credential outside Git.
# Five-second SQL timeout; custom metrics only; no access to note contents required.
DATA_SOURCE_NAME='postgresql://postgres_exporter:<SCRAM_PASSWORD>@127.0.0.1:5432/cairn?sslmode=disable&options=-c%20statement_timeout%3D5000'
ARGS="--web.listen-address=127.0.0.1:9189 --extend.query-path=/etc/prometheus-postgres-exporter/queries-cairn.yaml --disable-default-metrics --disable-settings-metrics --no-collector.database --no-collector.locks --no-collector.replication --no-collector.replication_slot --no-collector.stat_bgwriter --no-collector.stat_database --no-collector.stat_user_tables --no-collector.statio_user_tables --no-collector.wal"
