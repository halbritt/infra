# Dedicated Home Assistant telemetry store. The backend is loopback-only;
# vmauth-homeassistant is the authenticated tailnet ingress.
ARGS="-storageDataPath=/var/lib/victoria-metrics-homeassistant/data -retentionPeriod=2y -httpListenAddr=127.0.0.1:8428 -memory.allowedBytes=536870912 -storage.minFreeDiskSpaceBytes=20GB -dedup.minScrapeInterval=1ms -influx.databaseNames=homeassistant -relabelConfig=/etc/victoria-metrics-homeassistant/relabel.yml -loggerFormat=json"
