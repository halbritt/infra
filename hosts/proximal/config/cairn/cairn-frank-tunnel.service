[Unit]
Description=Frank private OpenAI tunnel for Cairn messaging
After=network-online.target cairn-api.service
Wants=network-online.target cairn-api.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B %h/.local/libexec/cairn-frank-tunnel.py
WorkingDirectory=%h
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=45
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
