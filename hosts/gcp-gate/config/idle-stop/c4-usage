#!/usr/bin/env python3
"""Report agent-ee-gate-c4 run time, estimated cost and recent busy share.

Run on proximal (gcloud is logged in there). Run time comes from the GCE audit
log (create/start versus stop/preempt/guest poweroff), so it covers stopped
periods too. Busy share comes from the VM's own once-a-minute log
(/var/log/infra-usage/usage.jsonl, written by infra-idle-stop) and needs the VM
to be running. Canonical source: infra hosts/gcp-gate/config/idle-stop/.
"""
import argparse
import datetime
import json
import subprocess

PROJECT, ZONE, NAME = "heath-stuff", "us-central1-a", "agent-ee-gate-c4"
RATE = 1.22  # $/h Spot compute, c4-highcpu-48 us-central1 (2026-10-22 catalog); disk is billed while stopped too
UP = ("insert", "start", "resume")
DOWN = ("stop", "preempted", "guestTerminate", "delete", "suspend")


def gcloud(*args):
    return subprocess.run(["gcloud", *args, "--project", PROJECT], capture_output=True, text=True, check=True).stdout


def events(days):
    query = (f'resource.type="gce_instance" AND protoPayload.resourceName:"instances/{NAME}" '
             f'AND operation.last=true')
    raw = json.loads(gcloud("logging", "read", query, f"--freshness={days}d", "--format=json", "--limit=1000"))
    out = []
    for entry in raw:
        if entry.get("severity") == "ERROR" or entry["protoPayload"].get("status", {}).get("code"):
            continue  # refused operations, e.g. code 8 (no Spot capacity) or quota
        method = entry["protoPayload"]["methodName"].rsplit(".", 1)[-1]
        kind = "up" if method in UP else "down" if method in DOWN else None
        if kind:
            out.append((datetime.datetime.fromisoformat(entry["timestamp"].replace("Z", "+00:00")), kind, method))
    return sorted(out)


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--days", type=int, default=7)
    args = parser.parse_args()
    now = datetime.datetime.now(datetime.timezone.utc)
    status = gcloud("compute", "instances", "describe", NAME, "--zone", ZONE, "--format=value(status)").strip()
    print(f"{NAME}: {status}")
    running_since, hours = None, 0.0
    for when, kind, method in events(args.days):
        print(f"  {when.astimezone():%Y-%m-%d %H:%M %Z}  {method}")
        if kind == "up" and running_since is None:
            running_since = when
        elif kind == "down" and running_since is not None:
            hours += (when - running_since).total_seconds() / 3600
            running_since = None
    if running_since is not None and status == "RUNNING":
        hours += (now - running_since).total_seconds() / 3600
    print(f"run time in the last {args.days} days (from audit log): {hours:.1f} h, about ${hours * RATE:.0f} compute")
    if status != "RUNNING":
        return
    tail = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", NAME,
                           "sudo tail -n 1440 /var/log/infra-usage/usage.jsonl"],
                          capture_output=True, text=True).stdout.splitlines()
    samples = [json.loads(line) for line in tail if line.strip()]
    if not samples:
        print("no usage samples")
        return
    busy = sum(sample["busy"] for sample in samples)
    last_busy = next((s["ts"] for s in reversed(samples) if s["busy"]), "never")
    print(f"busy {busy} of {len(samples)} minutes sampled since {samples[0]['ts']} ({100 * busy / len(samples):.0f}%);"
          f" last busy {last_busy}; now idle {samples[-1].get('idle_s', 0) // 60} min (stops at 30)")


if __name__ == "__main__":
    main()
