[Unit]
Description=Plane harm.org Docker bridge to loopback Garage S3
Documentation=file:/home/halbritt/git/proximal/plane-public/README.md
Requires=garage.service docker.service
After=garage.service docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:13900,bind=172.17.0.1,reuseaddr,fork TCP:127.0.0.1:3900
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
