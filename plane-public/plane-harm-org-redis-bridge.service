[Unit]
Description=Plane harm.org Docker bridge to loopback Redis
Documentation=file:/home/halbritt/git/proximal/plane-public/README.md
Requires=redis-server.service docker.service
After=redis-server.service docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:16379,bind=172.17.0.1,reuseaddr,fork TCP:127.0.0.1:6379
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
