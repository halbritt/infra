[Unit]
Description=Plane CE public-intended plane.harm.org instance (Docker Compose)
Documentation=file:/home/halbritt/git/proximal/plane-public/README.md
Requires=docker.service plane-harm-org-postgres-bridge.service plane-harm-org-redis-bridge.service plane-harm-org-garage-bridge.service
After=docker.service network-online.target plane-harm-org-postgres-bridge.service plane-harm-org-redis-bridge.service plane-harm-org-garage-bridge.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=halbritt
Group=halbritt
SupplementaryGroups=docker
WorkingDirectory=/home/halbritt/services/plane-harm-org
Environment=HOME=/home/halbritt
ExecStartPre=/usr/bin/docker compose -p plane-harm-org -f plane-app/docker-compose.yaml --env-file=plane-app/plane.env config --quiet
ExecStart=/usr/bin/docker compose -p plane-harm-org -f plane-app/docker-compose.yaml --env-file=plane-app/plane.env up -d --remove-orphans
ExecReload=/usr/bin/docker compose -p plane-harm-org -f plane-app/docker-compose.yaml --env-file=plane-app/plane.env up -d --force-recreate --pull never --remove-orphans
ExecStop=/usr/bin/docker compose -p plane-harm-org -f plane-app/docker-compose.yaml --env-file=plane-app/plane.env stop
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
