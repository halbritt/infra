# Values, never credentials — keep all secret-bearing material out of this repo.
.pgpass
*.pgpass
pg_hba.conf
.env
*.env
.envrc
*.dsn
__pycache__/
*.pyc
*secret*
*credential*
id_rsa*
*.pem
*.key

# Policy and SOPS ciphertext are the only tracked content below secrets/.
secrets/**
!secrets/
!secrets/README.md
!secrets/**/
!secrets/**/*.sops.yaml
!secrets/**/*.sops.json
!secrets/**/*.sops.env
