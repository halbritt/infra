# Appended to /etc/default/grafana-server (the grafana-server.service EnvironmentFile).
# GF_<SECTION>_<KEY> env vars override grafana.ini. No secret here — the admin password
# lives in /etc/grafana/admin.env (0600 root, NOT in git); see 10-proximal.conf + README.
GF_SERVER_HTTP_ADDR=100.85.100.81
GF_SERVER_HTTP_PORT=3003
GF_SERVER_ROOT_URL=http://100.85.100.81:3003/
GF_USERS_ALLOW_SIGN_UP=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
# Land on the PG dashboard instead of an empty home page (the dashboard lives in the
# "proximal" folder). Belt-and-suspenders with the org preference homeDashboardUID
# (stored in Grafana's DB; set via PUT /api/org/preferences).
GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/pg-proximal-health.json
