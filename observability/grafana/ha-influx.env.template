# Copy to /etc/grafana/ha-influx.env (0600 root), fill in real values, then add
#   EnvironmentFile=-/etc/grafana/ha-influx.env
# to the grafana-server 10-proximal.conf drop-in (alongside admin.env) and restart.
# These expand into provisioning-datasources-proximal.yaml's HA-InfluxDB datasource.
#
# Create a READ-ONLY user in the appliance's InfluxDB add-on (Chronograf UI ->
# InfluxDB Admin -> Users): grant READ on the "homeassistant" database only. Do NOT
# reuse the HA write user. Never commit the filled-in file.
INFLUX_HA_READ_USER=grafana_ro
INFLUX_HA_READ_PASSWORD=CHANGE_ME
