      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "timeFrom": "24h",
      "hideTimeOverride": true,
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influx-ha"
          },
          "refId": "A",
          "resultFormat": "time_series",
          "alias": "Indoor Temp",
          "rawQuery": true,
          "query": "SELECT last(\"value\") FROM \"\u00b0F\" WHERE (\"entity_id\" = 'gw1200b_indoor_temperature') AND $timeFilter GROUP BY time($__interval) fill(none)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "fahrenheit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 64
              },
              {
                "color": "orange",
