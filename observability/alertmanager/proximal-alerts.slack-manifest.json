{
  "display_information": {
    "name": "proximal-alerts",
    "description": "Prometheus Alertmanager notifications for host proximal (observability subsystem).",
    "background_color": "#a30f0f"
  },
  "features": {
    "bot_user": {
      "display_name": "proximal-alerts",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "incoming-webhook"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
