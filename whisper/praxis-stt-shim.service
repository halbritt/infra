[Unit]
Description=Praxis STT shim (octet-stream -> whisper.cpp) for LiveWhisperSTT
After=network.target whisper-stt.service
Wants=whisper-stt.service

[Service]
Type=simple
User=halbritt
WorkingDirectory=/home/halbritt/git/whisper.cpp
Environment=WHISPER_SERVER=http://127.0.0.1:8910
Environment=PRAXIS_STT_SHIM_PORT=8082
ExecStart=/usr/bin/python3 /home/halbritt/git/whisper.cpp/praxis-stt-shim.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
