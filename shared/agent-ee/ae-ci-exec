#!/usr/bin/env bash
# ae-ci-exec WORKTREE -- COMMAND [ARG...]
#
# Run COMMAND inside the agent-ee CI image built from WORKTREE's own Dockerfile,
# with the release gate's sandbox options, required inputs and environment
# (~/agent-ee-gate/ci-run.sh on peecee-wsl, agent-ee .github/workflows/ci.yml).
# The live worktree is mounted read-write at /opt/agent-ee, the image's source
# path, and COMMAND runs there as the calling user:
#
#   ae-ci-exec . -- python3 -m unittest tests.test_x
#   ae-ci-exec . -- python3 scripts/strict_suite.py --jobs 3 test_x test_y
#
# Image: agent-ee:exec-<16 hex>, the SHA-256 of the image build inputs (the
# Dockerfile plus every file its COPY instructions name, except "COPY ." whose
# /opt/agent-ee is replaced by the worktree mount). It is built once per input
# version under a flock, so concurrent callers share one image. Tags agent-ee:ci-*
# belong to the release gate and are never touched.
#
# Container, as in the gate's strict-suite step:
#   --network none, seccomp/systempaths/AppArmor unconfined (owner, 2026-10-23: no
#   AppArmor profiles; hosts set kernel.apparmor_restrict_unprivileged_userns=0 instead);
#   AGENT_EE_REQUIRE_TOOLCHAIN=1, PYTHONPATH=src, workdir /opt/agent-ee;
#   fome-mc at the ci.yml FOME_MC_COMMIT, read-only at /opt/fome-mc;
#   the J1 drawing (ci.yml J1_DRAWING_SHA256), read-only at /opt/j1/te-776228-1.pdf.
# Differences, all for running as the caller (--user UID:GID) on a live tree:
#   - the image's kicad-route pin checkout (/opt/kicad-route, owned by the image
#     user 10001) is extracted once per image into a caller-owned copy and mounted
#     read-only over /opt/kicad-route, so git ownership checks behave as in the gate;
#   - a private scratch dir is mounted at /tmp (TMPDIR=/tmp, HOME=/tmp, as in the
#     CI fixture step) and removed afterwards (AE_CI_KEEP_TMP=1 keeps it);
#   - git works on the tree (the image's /opt/agent-ee has no .git; agent-ee
#     code falls back to a file walk only when .git is absent, which a mount
#     cannot reproduce). For a linked worktree (.git is a file), the common gitdir
#     is mounted read-only and the worktree's own gitdir read-write, both at their
#     host paths, and /opt/agent-ee/.git names that gitdir by absolute path.
#     Object alternates are mounted read-only. Plain checkouts need nothing extra.
# AGENT_EE_SKIP_VISUALS is passed through when set.
#
# State: ${AE_CI_EXEC_HOME:-~/.cache/ae-ci-exec} (inputs, kicad-route copies,
# locks, build logs, scratch). No sudo. On an AppArmor host, bwrap in the container
# needs kernel.apparmor_restrict_unprivileged_userns=0 (set in /etc/sysctl.d).
# Exit status: COMMAND's, or 125 for a docker run error, 2 for usage/setup errors.
set -euo pipefail

prog=ae-ci-exec
die() { echo "$prog: $*" >&2; exit 2; }
usage() { echo "usage: $prog WORKTREE -- COMMAND [ARG...]" >&2; exit 2; }
[ $# -ge 3 ] && [ "$2" = -- ] || usage
wt=$(realpath -e -- "$1") || die "no such worktree: $1"
shift 2
[ -f "$wt/Dockerfile" ] && [ -f "$wt/.github/workflows/ci.yml" ] ||
  die "$wt is not an agent-ee worktree root (no Dockerfile or .github/workflows/ci.yml)"
command -v docker >/dev/null || die "docker not found"
command -v flock >/dev/null || die "flock not found"

# --- host-wide admission (native-admit, infra shared/agent-ee) ------------------
# Every run holds a native-admit lease for its whole life, image build included:
# strict_suite --jobs N weighs N (refused above max_weight), anything else 1. AE_CI_WEIGHT overrides
# the weight; AE_CI_MAX_WAIT (seconds) gives up with exit 75 instead of queueing
# indefinitely. Fails closed when native-admit is missing.
na=$(dirname "$(realpath -e -- "$0")")/native-admit  # installed side by side
[ -x "$na" ] || na=$(command -v native-admit) || die "native-admit not installed (infra shared/agent-ee)"
if [ "${AE_CI_EXEC_ADMITTED:-}" = 1 ]; then
  # Re-entry after admission: trust it only if this process inherited the live lease descriptor.
  "$na" verify >/dev/null || die "AE_CI_EXEC_ADMITTED set without an inherited live lease"
else
  admit=(--label "ae-ci-exec $(basename "$wt"): $*")
  [ -z "${AE_CI_WEIGHT:-}" ] || admit+=(--weight "$AE_CI_WEIGHT")
  [ -z "${AE_CI_MAX_WAIT:-}" ] || admit+=(--max-wait "$AE_CI_MAX_WAIT")
  AE_CI_EXEC_ADMITTED=1 exec "$na" run "${admit[@]}" -- "$(realpath -e -- "$0")" "$wt" -- "$@"
fi
unset AE_CI_EXEC_ADMITTED

STATE=${AE_CI_EXEC_HOME:-$HOME/.cache/ae-ci-exec}
mkdir -p "$STATE"/{inputs,kicad-route,locks,logs,tmp,ctx}
locked() {  # locked NAME COMMAND...: run COMMAND holding $STATE/locks/NAME.lock
  local name=$1; shift
  (
    exec 9>"$STATE/locks/$name.lock"
    flock -n 9 || { echo "$prog: waiting for lock $name" >&2; flock 9; }
    "$@"
  )
}

# --- CI pins, read from this worktree's workflow (same sed as ci-run.sh) -------
ci_env() { sed -n "s/^ *$1: *\([^ #]*\).*/\1/p" "$wt/.github/workflows/ci.yml" | head -n 1; }
FOME_MC_COMMIT=$(ci_env FOME_MC_COMMIT)
J1_DRAWING_SHA256=$(ci_env J1_DRAWING_SHA256)
J1_DRAWING_URL=$(ci_env J1_DRAWING_URL)
[[ $FOME_MC_COMMIT =~ ^[0-9a-f]{40}$ ]] && [[ $J1_DRAWING_SHA256 =~ ^[0-9a-f]{64}$ ]] ||
  die "cannot read the CI pins from $wt/.github/workflows/ci.yml"

# --- image tag: hash of the build inputs ---------------------------------------
# COPY sources other than "." and other than --from stages, relative to the context.
mapfile -t copy_srcs < <(awk 'toupper($1) == "COPY" {
    n = 0; from = 0
    for (i = 2; i <= NF; i++) { if ($i ~ /^--from=/) from = 1; else if ($i !~ /^--/) a[++n] = $i }
    if (!from) for (i = 1; i < n; i++) if (a[i] != ".") print a[i]
  }' "$wt/Dockerfile" | sort -u)
inputs=(Dockerfile)
for s in "${copy_srcs[@]}"; do
  [[ $s != /* && $s != *..* ]] || die "unsupported COPY source $s"
  [ -e "$wt/$s" ] || die "COPY source $s missing in $wt"
  while IFS= read -r -d '' f; do inputs+=("${f#./}"); done < <(cd "$wt" && find "./$s" -type f -print0)
done
mapfile -t inputs < <(printf '%s\n' "${inputs[@]}" | LC_ALL=C sort -u)
# One line per file: path, executable bit, content hash. Git checkouts differ only
# in umask, so only the executable bit is kept (the context uses 775/664 like git archive).
hash_line() { local x=0; [ -x "$wt/$1" ] && x=1; printf '%s %s %s\n' "$1" "$x" "$(sha256sum < "$wt/$1" | cut -c1-64)"; }
input_hash=$(for f in "${inputs[@]}"; do hash_line "$f"; done | sha256sum | cut -c1-64)
TAG=agent-ee:exec-${input_hash:0:16}
KR=$STATE/kicad-route/${input_hash:0:16}

build_image() {
  docker image inspect "$TAG" >/dev/null 2>&1 && return 0
  local ctx=$STATE/ctx/${input_hash:0:16}.$$ log=$STATE/logs/build-${input_hash:0:16}-$(date -u +%Y%m%dT%H%M%SZ).log f
  rm -rf "$ctx"; mkdir -p "$ctx"
  for f in "${inputs[@]}"; do
    mkdir -p "$ctx/$(dirname "$f")"; cp "$wt/$f" "$ctx/$f"
    if [ -x "$wt/$f" ]; then chmod 775 "$ctx/$f"; else chmod 664 "$ctx/$f"; fi
  done
  # Recheck the copied bytes against the hash (the worktree is live).
  [ "$(cd "$ctx" && for f in "${inputs[@]}"; do x=0; [ -x "$f" ] && x=1; printf '%s %s %s\n' "$f" "$x" "$(sha256sum < "$f" | cut -c1-64)"; done | sha256sum | cut -c1-64)" = "$input_hash" ] ||
    { rm -rf "$ctx"; die "build inputs changed while copying; retry"; }
  echo "$prog: building $TAG from $wt (log $log)" >&2
  local attempts=${BUILD_ATTEMPTS:-6} delay=30 n=1 start
  while :; do
    start=$(date +%s)
    if docker buildx build --builder default --progress=plain --load \
        --label ae-ci-exec.inputs="$input_hash" -t "$TAG" "$ctx" >>"$log" 2>&1; then
      echo "=== built $TAG in $(( $(date +%s) - start ))s (attempt $n)" | tee -a "$log" >&2
      break
    fi
    # Mirror 503s fail a layer; BuildKit keeps finished layers, so a retry resumes.
    if [ "$n" -ge "$attempts" ]; then
      tail -n 30 "$log" >&2; rm -rf "$ctx"; die "image build failed after $n attempts; log $log"
    fi
    echo "$prog: build attempt $n failed; retrying in ${delay}s (log $log)" >&2
    sleep "$delay"; delay=$(( delay * 2 > 600 ? 600 : delay * 2 )); n=$(( n + 1 ))
  done
  rm -rf "$ctx"
}

# The image's kicad-route checkout, owned by the caller (the gate's runtime user owns it).
extract_kicad_route() {
  [ -f "$KR.ready" ] && return 0
  rm -rf "$KR" "$KR.partial"; mkdir -p "$KR.partial"
  local cid
  cid=$(docker create --network none "$TAG" true)
  docker cp "$cid:/opt/kicad-route" - | tar -x -p -C "$KR.partial" || { docker rm "$cid" >/dev/null; die "cannot extract /opt/kicad-route"; }
  docker rm "$cid" >/dev/null
  mv "$KR.partial/kicad-route" "$KR"; rmdir "$KR.partial"
  # Refresh the index stat data for the caller-owned copy, then verify it offline
  # with the image's own installer check, read-only as it is mounted later.
  docker run --rm --network none --user "$(id -u):$(id -g)" -e HOME=/tmp -w / -v "$KR:/opt/kicad-route" \
    "$TAG" git -C /opt/kicad-route update-index -q --refresh >/dev/null 2>&1 || true
  docker run --rm --network none --user "$(id -u):$(id -g)" -e HOME=/tmp -w / -v "$KR:/opt/kicad-route:ro" \
    "$TAG" /usr/local/share/agent-ee/kicad-route/install.sh verify >&2 ||
    { rm -rf "$KR"; die "kicad-route copy failed install.sh verify"; }
  touch "$KR.ready"
}

# Required inputs, acquired as ci-run.sh does, owned by the caller (the runtime user).
fetch_inputs() {
  local store=$STATE/inputs/fome-mc-$FOME_MC_COMMIT
  g() { GIT_TERMINAL_PROMPT=0 GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -c safe.directory='*' "$@"; }
  if [ ! -d "$store/.git" ]; then
    echo "$prog: cloning fome-mc at $FOME_MC_COMMIT" >&2
    rm -rf "$store.partial"
    g -c credential.helper= -c http.extraheader= clone --quiet --no-checkout https://github.com/halbritt/fome-mc "$store.partial"
    g -C "$store.partial" checkout --quiet --detach "$FOME_MC_COMMIT"
    mv "$store.partial" "$store"
  fi
  [ "$(g -C "$store" rev-parse --verify 'HEAD^{commit}')" = "$FOME_MC_COMMIT" ] || die "fome-mc store $store is not at $FOME_MC_COMMIT"
  ! g -C "$store" config --local --get-regexp '^(http\..*\.extraheader|credential\.)' >/dev/null || die "credentials persisted in $store"
  [ "$(stat -c %u "$store")" = "$(id -u)" ] || die "fome-mc store $store is not owned by $(id -un)"
  local j1=$STATE/inputs/te-776228-1.pdf
  if [ ! -f "$j1" ]; then
    echo "$prog: fetching the J1 drawing" >&2
    curl --fail --silent --show-error --location --proto '=https' --retry 2 \
      --max-time 90 --max-filesize 10000000 --user-agent 'Mozilla/5.0 (X11; Linux x86_64)' \
      "$J1_DRAWING_URL" --output "$j1.partial"
    printf '%s  %s\n' "$J1_DRAWING_SHA256" "$j1.partial" | sha256sum --check --strict --quiet ||
      { rm -f "$j1.partial"; die "J1 drawing hash mismatch"; }
    chmod 0444 "$j1.partial"; mv "$j1.partial" "$j1"
  fi
  printf '%s  %s\n' "$J1_DRAWING_SHA256" "$j1" | sha256sum --check --strict --quiet || die "J1 drawing $j1 hash mismatch"
}

locked "inputs" fetch_inputs
locked "image-${input_hash:0:16}" build_image
locked "image-${input_hash:0:16}" extract_kicad_route

# --- sandbox options (ci.yml "Permit container user namespaces") ---------------
if [ "$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2>/dev/null || echo 0)" != 0 ]; then
  die "kernel.apparmor_restrict_unprivileged_userns=1 blocks bwrap in the container; set it to 0 (shared/agent-ee/README.md)"
fi
SANDBOX_OPTS=(--network none --security-opt seccomp=unconfined --security-opt apparmor=unconfined
              --security-opt systempaths=unconfined)
# Admission bounds: CPU quota scaled to the lease weight, a PID cap, and an init that
# reaps orphaned bwrap children. Images from agent-ee 7e5bdc46 on (AGENTEE-459) run
# tini as their ENTRYPOINT; older images get docker's own init (--init).
LIMIT_OPTS=(--label "native-admission.lease=${NATIVE_ADMISSION_LEASE:-}")
[ -z "${NATIVE_ADMISSION_CPUS:-}" ] || LIMIT_OPTS+=(--cpus "$NATIVE_ADMISSION_CPUS")
[ -z "${NATIVE_ADMISSION_PIDS:-}" ] || LIMIT_OPTS+=(--pids-limit "$NATIVE_ADMISSION_PIDS")
[[ $(docker image inspect -f '{{json .Config.Entrypoint}}' "$TAG") == *tini* ]] || LIMIT_OPTS+=(--init)

scratch=$(mktemp -d "$STATE/tmp/run-XXXXXXXX")
name=ae-ci-exec-$(basename "$scratch" | tr 'A-Z' 'a-z')
# Git metadata outside the worktree: a linked worktree's gitdir and common dir,
# and object alternates, at their host paths.
git_mounts=() gitfile=
if [ -e "$wt/.git" ] && command -v git >/dev/null; then
  if mapfile -t gd < <(git -C "$wt" rev-parse --path-format=absolute --git-dir --git-common-dir 2>/dev/null) &&
     [ "${#gd[@]}" = 2 ]; then
    git_dir=${gd[0]} common_dir=${gd[1]}
    if [ -f "$wt/.git" ]; then
      git_mounts+=(-v "$common_dir:$common_dir:ro")
      [ "$git_dir" = "$common_dir" ] || git_mounts+=(-v "$git_dir:$git_dir")
      # The gitfile may hold a relative path; name the gitdir absolutely.
      gitfile=$scratch.gitfile
      printf 'gitdir: %s\n' "$git_dir" > "$gitfile"
      git_mounts+=(-v "$gitfile:/opt/agent-ee/.git:ro")
    fi
    if [ -f "$common_dir/objects/info/alternates" ]; then
      while IFS= read -r alt; do
        [ -n "$alt" ] && [ "${alt#\#}" = "$alt" ] || continue
        [[ $alt = /* ]] || alt=$(realpath -m "$common_dir/objects/$alt")
        case $alt in "$wt"|"$wt"/*|"$common_dir"|"$common_dir"/*) ;; *) git_mounts+=(-v "$alt:$alt:ro") ;; esac
      done < "$common_dir/objects/info/alternates"
    fi
  else
    echo "$prog: warning: git cannot read $wt/.git; git commands in the container will fail" >&2
  fi
fi
env_opts=(-e AGENT_EE_REQUIRE_TOOLCHAIN=1 -e PYTHONPATH=src -e HOME=/tmp -e TMPDIR=/tmp
          -e AGENT_EE_FOME_MC_CHECKOUT=/opt/fome-mc -e AGENT_EE_J1_DRAWING=/opt/j1/te-776228-1.pdf)
[ -z "${AGENT_EE_SKIP_VISUALS+x}" ] || env_opts+=(-e "AGENT_EE_SKIP_VISUALS=$AGENT_EE_SKIP_VISUALS")
tty=(-i); [ -t 0 ] && [ -t 1 ] && tty=(-i -t)
# AE_CI_TMPFS=SIZE (e.g. 8g): the per-run /tmp scratch is a memory-backed tmpfs capped
# at SIZE instead of a disk directory. Only for nondurable scratch: receipts, logs and
# summaries a command writes into the worktree stay on disk. AE_CI_KEEP_TMP cannot
# keep a tmpfs.
scratch_mount=(-v "$scratch:/tmp")
if [ -n "${AE_CI_TMPFS:-}" ]; then
  [[ $AE_CI_TMPFS =~ ^[0-9]+[kmg]?$ ]] || die "AE_CI_TMPFS must be a size like 8g"
  scratch_mount=(--mount "type=tmpfs,destination=/tmp,tmpfs-size=$AE_CI_TMPFS,tmpfs-mode=1777")
  [ "${AE_CI_KEEP_TMP:-0}" != 1 ] || echo "$prog: AE_CI_KEEP_TMP ignored with AE_CI_TMPFS" >&2
fi

cleanup() {
  docker kill "$name" >/dev/null 2>&1 || true
  [ -z "$gitfile" ] || rm -f "$gitfile"
  if [ "${AE_CI_KEEP_TMP:-0}" = 1 ]; then echo "$prog: kept scratch $scratch" >&2; else rm -rf "$scratch"; fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

status=0
docker run --rm --name "$name" --label ae-ci-exec=1 "${tty[@]}" "${SANDBOX_OPTS[@]}" "${LIMIT_OPTS[@]}" \
  --user "$(id -u):$(id -g)" "${env_opts[@]}" \
  -v "$wt:/opt/agent-ee" "${git_mounts[@]}" "${scratch_mount[@]}" \
  -v "$STATE/inputs/fome-mc-$FOME_MC_COMMIT:/opt/fome-mc:ro" \
  -v "$STATE/inputs/te-776228-1.pdf:/opt/j1/te-776228-1.pdf:ro" \
  -v "$KR:/opt/kicad-route:ro" \
  -w /opt/agent-ee "$TAG" "$@" <&0 &
wait $! || status=$?
exit "$status"
