#!/usr/bin/env bash
# ae-ci-exec WORKTREE -- COMMAND [ARG...]
# ae-ci-exec --hold IMAGE [--router] -- COMMAND [ARG...]
#                                   run COMMAND while IMAGE (and its kicad-route copy) is held
# ae-ci-exec --router-copy IMAGE    print the path of IMAGE's verified kicad-route copy
# ae-ci-exec --gc [--dry-run]       evict unused images and router copies now
#
# Run COMMAND inside the agent-ee CI image built from WORKTREE's own Dockerfile,
# with the release gate's sandbox options, required inputs and environment
# (~/agent-ee-gate/ci-run.sh on peecee-wsl, agent-ee .github/workflows/ci.yml).
# The live worktree is mounted read-write at /opt/agent-ee, the image's source
# path, and COMMAND runs there as the calling user:
#
#   ae-ci-exec . -- python3 -m unittest tests.test_x
#   ae-ci-exec . -- python3 scripts/strict_suite.py --jobs 3 test_x test_y
#
# Image: the BuildKit build of WORKTREE's Dockerfile rechecks upstream: the Dockerfile
# ADDs remote files that follow upstream releases (the KiCad 10.0 PPA InRelease,
# kicad-happy's git refs), and BuildKit fetches them again only when a build runs (owner,
# 2026-11-03: nothing pinned; versions fixed per run, recorded, kept up to date). A run
# builds when upstream was last checked for these inputs more than AE_CI_REFRESH_HOURS ago
# (default 6; 0 checks on every run), when exec-KEY-current is missing, or when the local
# inputs changed (a new KEY). Otherwise it reuses exec-KEY-current without building and
# prints when upstream was last checked. A run also shares the build of a run it waited
# for. When nothing changed upstream, a build takes every layer from the cache. KEY is
# the first 16 hex of the SHA-256 of the build inputs: the Dockerfile plus every file its
# COPY instructions name, except "COPY ." whose /opt/agent-ee is replaced by the
# worktree mount. Tags (agent-ee:ci-* belong to the release gate and are never touched):
#   agent-ee:exec-KEY-current  the newest image this version built for these inputs;
#                              each successful build moves it to its result.
#   agent-ee:exec-KEY-ID12     one image, ID12 = the first 12 hex of its ID; never moved.
#   agent-ee:exec-KEY          the tag of ae-ci-exec versions before 2026-11-03 and of
#                              image_for. A build creates it when it is missing and never
#                              moves it. When exec-KEY-current is missing, this version
#                              seeds it once from exec-KEY, if that image is labelled with
#                              these exact inputs, so its first run has a fallback image.
#                              Keeping it fixed protected callers of versions before
#                              d988c8d, which reread it after releasing the lock. That
#                              transition is over: d988c8d is installed and no older copy
#                              runs. A stale key loses this tag with its other heads.
# "Missing" above means that Docker answered "No such image" for exactly that tag. Any
# other failure of an image lookup (docker image inspect) aborts the run with exit 2
# before the tag write it guards, so an unknown answer never creates or moves a tag.
# Each run resolves one image ID at its start and prints it on stderr
# ("ae-ci-exec: image sha256:..."). Tags only find an image. Every later read,
# extraction, verification and container uses the full image ID (sha256:...), so a tag
# that moves cannot change what a run reads or runs. Containers carry the label
# ae-ci-exec=1, by which native-admit counts them, since they show no agent-ee: name.
# builds/KEY records the latest build and the last successful upstream check; each
# build log records its image ID. ae-ci-exec writes no other run record.
#
# Concurrency: builds, every read or move of exec-KEY-current, and every tag write run
# under the flock locks/image-KEY.lock. image_for takes the same lock. Runs that start
# together share one build (see resolve_image).
#
# Build failures: "docker buildx build" is retried for transient mirror errors
# (snapshot.ubuntu.com, Launchpad, GitHub). The default number of attempts is 2, with
# one 30 s backoff, when exec-KEY-current names an image labelled with these exact
# inputs (possibly just seeded from exec-KEY), so the run has an image to fall back to.
# Otherwise it is 6, with backoffs of 30, 60, 120, 240 and 480 s (15.5 minutes).
# BUILD_ATTEMPTS overrides both. There is no error classifier, so every nonzero build
# result counts: unreachable upstream, a new release that breaks a RUN step, a daemon
# error.
#   Fall back: when every attempt fails and exec-KEY-current names an image labelled
#     with these exact inputs, the run uses that image. First it prints a loud stderr
#     warning: the image was not refreshed because the build failed, the build log, the
#     image ID and creation time, and the remote ADDs the image may lag. Runs that waited
#     for that build share its failure, print its last log lines, and fall back the same way.
#   Exit 2, no fallback: no such image exists; the inputs changed while being copied;
#     the build reported no image ID, or exec-KEY-current does not name it; an image
#     lookup failed other than with "No such image"; copying /opt/kicad-route out of the
#     image (docker cp | tar), its tree identity check, or its install.sh verify failed.
#     Each of these calls die.
#   The command's own nonzero status, no fallback (set -e): any other failing command,
#     such as docker tag or create outside the build, a write to the state directory (a
#     full disk), git or curl.
#   INT, TERM or HUP during a build ends the run.
#
# kicad-route copies: the image's kicad-route checkout (/opt/kicad-route, owned by the
# image user 10001) is extracted into a caller-owned copy and mounted read-only over
# /opt/kicad-route, so git ownership checks behave as in the gate. A copy is keyed by the
# tree identity of /opt/kicad-route in the image: the SHA-256 of a listing of every entry
# (path, type, permission bits, size, and content SHA-256 or symlink target; mtimes and
# owners excluded). One container step started from the image ID computes it, inside
# the caller's lease, and the result is cached per image ID in tree-id/. Equal identities
# mean byte-identical trees, so images with the same tree share one copy,
# kicad-route/tree-IDENTITY. A rebuild that changes only later layers (kicad-happy, say)
# adds no copy. A new copy must show the same identity on the host before it is
# published. Then it is verified offline with the install.sh verify of the image that
# asked for it, and its .ready record holds the identity, the entry count and that image.
#
# Other tools (image_for, the benchmark, review and run_in_image harnesses):
#   --hold IMAGE [--router] -- COMMAND: claims IMAGE as a run does and holds its use
#     lock for COMMAND's whole life. With --router it also holds the use lock of IMAGE's
#     verified copy and exports AE_CI_ROUTER_COPY with its path. It exports
#     AE_CI_IMAGE_ID, marks use when it starts and ends, and returns COMMAND's status.
#     It takes no native-admit lease: run it inside the caller's admitted job, which
#     also pays for a copy it may extract.
#   --router-copy IMAGE: ensures and prints the verified copy's path, marked used. It
#     holds nothing once it exits, so a caller that keeps using the copy should use
#     --hold. It runs under a native-admit lease like a run, or under the caller's.
#   Both take gc.lock shared before their first image lookup, then the image's key lock
#     (from its ae-ci-exec.inputs label) while they claim it, as runs do.
#
# Retention: at the end of every run (AE_CI_AUTO_GC=0 skips it), and on
# "ae-ci-exec --gc", unused images and router copies are evicted.
#   Images: only repository agent-ee, only tags exec-* and run-*. An image is kept while
#     a container (running or stopped) uses it, while it is the target of exec-KEY,
#     exec-KEY-current or run-KEY for a key in use (below), while a run or a --hold holds
#     it (its use lock), and for AE_CI_KEEP_DAYS (default 3) after it was created or last
#     used. Otherwise its exec-* and run-* tags are removed, and Docker deletes the image
#     when no tag is left. AE_CI_GC_KEYS (16-hex keys, space or comma separated) limits
#     this, and the heads rule, to those keys.
#   Heads: a key with no sign of use within AE_CI_KEEP_HEAD_DAYS (default 7) loses its
#     heads exec-KEY, exec-KEY-current and run-KEY. A container that uses one of its images
#     prevents this, and so does a build, run or --hold that holds its image lock or the
#     use lock of one of its images. The signs of use are a use marker of one of its
#     images, its build record, and an ae-ci-exec or image_for build log for the key. A
#     build counts as a use, because image_for and d988c8d write no use markers. After the
#     pass takes the key's lock, it reads these again and rechecks each head tag's image
#     before it removes the tag. Its images then fall under the image rule, in the same pass.
#   Router copies: kept while a container mounts the copy, while a run or --hold holds it,
#     and for AE_CI_KEEP_DAYS after its last use; otherwise removed. Copies of earlier
#     versions (kicad-route/sha256-ID and kicad-route/KEY), which record no use, count
#     from their .ready time. Other names are left alone.
#   Use: each run, --hold and --router-copy touches used/image/ID and used/route/NAME.
#   Locks: a run or --hold holds locks/gc.lock shared while it resolves its image and
#     ensures its copy, and the image's and the copy's use locks shared until it exits.
#     Eviction holds gc.lock exclusively; it skips any image or copy whose use or
#     extraction lock it cannot take at once, and it lists the containers again right
#     before each removal. A run's eviction does not wait for gc.lock (it is skipped
#     while a run is claiming); --gc waits up to AE_CI_GC_WAIT seconds (default 60).
#   Versions: no pass runs while a process runs an ae-ci-exec script whose SHA-256
#     differs from this one (bash's open script, or the script a waiting native-admit
#     will start). Older versions take no use locks, so eviction waits until they have
#     drained, and logs that it skipped. The scan runs again after gc.lock is taken and
#     right before every removal of a tag or copy, each time with a fresh container
#     listing; if another version has appeared, the rest of the pass is abandoned. Only a
#     version that starts between that last scan and the removal itself is missed.
#     AE_CI_GC_IGNORE_OLD_VERSIONS=1 runs a pass anyway (it logs the versions it found at
#     the start); it is only for tests on private keys (AE_CI_GC_KEYS) and a private state.
#   --gc --dry-run reports on stderr what a pass would remove. It takes no lock and
#     writes nothing: no state directory, lock, log or temporary file.
#   Every removal, and the bytes freed, go to stderr and to logs/gc.log. Nothing outside
#     the state directory and no other repository's image is touched.
#   Bounds: this is an age policy, not a count. With the defaults, an image stays while
#     it is a head of a key used in the last 7 days, while a container, a --hold or a run
#     uses it, and for 3 days after it was created or last used. With this version as the
#     only producer, an active key gains at most 4 images a day (one upstream check per
#     6 hours, fewer when upstream did not change), about 12 in 3 days. image_for and
#     d988c8d build on every invocation and can add more, and containers, holds and
#     repeated use keep images longer. Router copies: one for each distinct tree used in
#     the last 3 days, plus those mounted or held.
#
# Container, as in the gate's strict-suite step:
#   --network none, seccomp/systempaths/AppArmor unconfined (owner, 2026-10-23: no
#   AppArmor profiles; hosts set kernel.apparmor_restrict_unprivileged_userns=0 instead);
#   AGENT_EE_REQUIRE_TOOLCHAIN=1, PYTHONPATH=src, workdir /opt/agent-ee;
#   fome-mc at the ci.yml FOME_MC_COMMIT, read-only at /opt/fome-mc;
#   the J1 drawing (ci.yml J1_DRAWING_SHA256), read-only at /opt/j1/te-776228-1.pdf.
# Differences, all for running as the caller (--user UID:GID) on a live tree:
#   - the caller-owned kicad-route copy above, read-only over /opt/kicad-route;
#   - a private scratch dir is mounted at /tmp (TMPDIR=/tmp, HOME=/tmp, as in the
#     CI fixture step) and removed afterwards (AE_CI_KEEP_TMP=1 keeps it);
#   - git works on the tree (the image's /opt/agent-ee has no .git; agent-ee
#     code falls back to a file walk only when .git is absent, which a mount
#     cannot reproduce). For a linked worktree (.git is a file), the common gitdir
#     is mounted read-only and the worktree's own gitdir read-write, both at their
#     host paths, and /opt/agent-ee/.git names that gitdir by absolute path.
#     Object alternates are mounted read-only. Plain checkouts need nothing extra.
# AGENT_EE_SKIP_VISUALS is passed through when set.
# AE_CI_INPUT_MANIFEST selects an agent-ee.native-inputs/1 file. Explicit
# selection is required; no ambient manifest is discovered. Its explicitly named
# sources are verified, copied into AE_CI_EVIDENCE_DIR, and mounted read-only at
# /opt/agent-ee-inputs/NAME. Only the manifest's named input variables are exported.
# Each run retains its input snapshots and receipt beside an output directory
# mounted at /artifacts; snapshots have no writable container alias. The manifest
# requires AE_CI_EVIDENCE_DIR to select durable storage outside the checkout.
#
# State: ${AE_CI_EXEC_HOME:-~/.cache/ae-ci-exec} (inputs, kicad-route copies, locks,
# build and gc logs, build records in builds/, use markers in used/, tree identities in
# tree-id/, scratch). No sudo. On an AppArmor host, bwrap in the container
# needs kernel.apparmor_restrict_unprivileged_userns=0 (set in /etc/sysctl.d).
# Exit status: COMMAND's. 125 when docker run cannot start it. 2 for usage errors and
# the checks that call die. A failing setup command's own status, as listed above.
# native-admit returns 1 when it refuses the weight and 75 when AE_CI_MAX_WAIT expires.
# An eviction failure at the end of a run is reported and does not change the status.
set -euo pipefail

prog=ae-ci-exec
die() { echo "$prog: $*" >&2; exit 2; }
usage() {
  echo "usage: $prog WORKTREE -- COMMAND [ARG...] | $prog --hold IMAGE [--router] -- COMMAND [ARG...] |" \
       "$prog --router-copy IMAGE | $prog --gc [--dry-run]" >&2
  exit 2
}
self=$(realpath -e -- "$0")
# This script's own bytes (bash keeps the script it runs open on fd 255): eviction runs
# only while no other version is running.
self_hash=$(sha256sum < "/proc/$$/fd/255" 2>/dev/null | cut -c1-64) || self_hash=''
[ -n "$self_hash" ] || self_hash=$(sha256sum < "$self" | cut -c1-64)
dry=0 want_router=0
case ${1:-} in
  --router-copy) [ $# = 2 ] || usage; mode=router-copy image_arg=$2 ;;
  --hold)
    mode=hold; shift; [ $# -ge 3 ] || usage
    image_arg=$1; shift
    if [ "$1" = --router ]; then want_router=1; shift; fi
    [ "${1:-}" = -- ] || usage; shift
    [ $# -ge 1 ] || usage ;;
  --gc)
    mode=gc
    if [ $# = 2 ] && [ "$2" = --dry-run ]; then dry=1; elif [ $# != 1 ]; then usage; fi ;;
  *)
    mode=run
    [ $# -ge 3 ] && [ "$2" = -- ] || usage
    wt=$(realpath -e -- "$1") || die "no such worktree: $1"
    shift 2
    [ -f "$wt/Dockerfile" ] && [ -f "$wt/.github/workflows/ci.yml" ] ||
      die "$wt is not an agent-ee worktree root (no Dockerfile or .github/workflows/ci.yml)" ;;
esac
if [ "$mode" = run ] && [ -n "${AE_CI_OUTCOME_FILE:-}" ] && [ -z "${AE_CI_OUTCOME_TOKEN:-}" ]; then
  outcome=$AE_CI_OUTCOME_FILE
  outcome_args=(--record "$outcome" --runner "$self" --forbid-path "$wt"
                --forbid-path "${AE_CI_EXEC_HOME:-$HOME/.cache/ae-ci-exec}")
  [ -z "${AE_CI_EVIDENCE_DIR:-}" ] || outcome_args+=(--forbid-path "$AE_CI_EVIDENCE_DIR")
  outcome_gitdir=$(git -C "$wt" rev-parse --absolute-git-dir 2>/dev/null) || outcome_gitdir=
  [ -z "$outcome_gitdir" ] || outcome_args+=(--forbid-path "$outcome_gitdir")
  exec python3 "$(dirname "$self")/ae-ci-outcome.py" run "${outcome_args[@]}" \
    -- "$self" "$wt" -- "$@"
fi
command -v docker >/dev/null || die "docker not found"
command -v flock >/dev/null || die "flock not found"

# --- host-wide admission (native-admit, infra shared/agent-ee) ------------------
# Every run holds a native-admit lease for its whole life, image build included:
# strict_suite --jobs N weighs N (refused above max_weight), anything else 1. AE_CI_WEIGHT overrides
# the weight; AE_CI_MAX_WAIT (seconds) gives up with exit 75 instead of queueing
# indefinitely. Fails closed when native-admit is missing. --router-copy is admitted the
# same way (inside an admitted job it reuses that lease); --hold and --gc take no lease.
if [ "$mode" = run ] || [ "$mode" = router-copy ]; then
  na=$(dirname "$self")/native-admit  # installed side by side
  [ -x "$na" ] || na=$(command -v native-admit) || die "native-admit not installed (infra shared/agent-ee)"
  if [ "${AE_CI_EXEC_ADMITTED:-}" = 1 ]; then
    # Re-entry after admission: trust it only if this process inherited the live lease descriptor.
    "$na" verify >/dev/null || die "AE_CI_EXEC_ADMITTED set without an inherited live lease"
  elif [ "$mode" = router-copy ]; then
    admit=(--label "ae-ci-exec --router-copy $image_arg")
    [ -z "${AE_CI_MAX_WAIT:-}" ] || admit+=(--max-wait "$AE_CI_MAX_WAIT")
    AE_CI_EXEC_ADMITTED=1 exec "$na" run "${admit[@]}" -- "$self" --router-copy "$image_arg"
  else
    admit=(--label "ae-ci-exec $(basename "$wt"): $*")
    [ -z "${AE_CI_WEIGHT:-}" ] || admit+=(--weight "$AE_CI_WEIGHT")
    [ -z "${AE_CI_MAX_WAIT:-}" ] || admit+=(--max-wait "$AE_CI_MAX_WAIT")
    AE_CI_EXEC_ADMITTED=1 exec "$na" run "${admit[@]}" -- "$self" "$wt" -- "$@"
  fi
  unset AE_CI_EXEC_ADMITTED
fi

STATE=${AE_CI_EXEC_HOME:-$HOME/.cache/ae-ci-exec}
case $STATE in /*) ;; *) die "AE_CI_EXEC_HOME must be an absolute path" ;; esac
[ "$STATE" != / ] || die "AE_CI_EXEC_HOME must not be /"
# A dry run writes nothing, not even the state directories.
[ "$dry" = 1 ] || mkdir -p "$STATE"/{inputs,kicad-route,locks,logs,tmp,ctx,builds,used/image,used/route,tree-id}
REFRESH_HOURS=${AE_CI_REFRESH_HOURS:-6}
KEEP_DAYS=${AE_CI_KEEP_DAYS:-3}
KEEP_HEAD_DAYS=${AE_CI_KEEP_HEAD_DAYS:-7}
[[ $REFRESH_HOURS =~ ^[0-9]+$ ]] || die "AE_CI_REFRESH_HOURS must be a whole number of hours"
[[ $KEEP_DAYS =~ ^[0-9]+$ ]] || die "AE_CI_KEEP_DAYS must be a whole number of days"
[[ $KEEP_HEAD_DAYS =~ ^[0-9]+$ ]] || die "AE_CI_KEEP_HEAD_DAYS must be a whole number of days"
GC_KEYS=${AE_CI_GC_KEYS:-}
GC_KEYS=${GC_KEYS//,/ }
for k in $GC_KEYS; do [[ $k =~ ^[0-9a-f]{16}$ ]] || die "AE_CI_GC_KEYS: $k is not a 16-hex key"; done
# Labels of every container this script starts: native-admit counts them by ae-ci-exec=1.
CONTAINER_LABELS=(--label ae-ci-exec=1 --label "native-admission.lease=${NATIVE_ADMISSION_LEASE:-}")

locked() {  # locked NAME COMMAND...: run COMMAND holding $STATE/locks/NAME.lock
  local name=$1; shift
  (
    exec 9>"$STATE/locks/$name.lock"
    if ! flock -n 9; then
      echo "$prog: waiting for lock $name" >&2
      local asked=$SECONDS
      flock 9
      echo "$prog: got lock $name after $(( SECONDS - asked ))s" >&2
    fi
    "$@"
  )
}
take_gc_shared() {  # gc.lock shared on fd 7: no eviction pass runs while this process claims
  exec 7>"$STATE/locks/gc.lock"
  if ! flock -s -n 7; then
    echo "$prog: waiting for lock gc (an eviction pass is running)" >&2
    flock -s 7
  fi
}

# Image lookups. An answer of "absent" allows tag writes (create a missing tag, seed a
# missing exec-KEY-current), so absence must be positive. Only Docker's exact reply for
# exactly this REF counts: the output, empty lines and the trailing newline aside, must
# equal "Error response from daemon: No such image: REF". Every other failed inspect
# aborts with die (exit 2) before the tag write it guards: an unreachable daemon, a
# connection reset, a timeout, a reply naming another REF (such as REF-current), or a
# not-found line mixed with other output. stdout and stderr are captured together, so no
# temporary file is written (a dry run writes nothing). The helpers set the variable
# "found" instead of printing, because a die inside $(...) would end only that subshell,
# and a test such as [ -z "$(...)" ] discards that status.
# inspect_image FORMAT REF: found = docker image inspect -f FORMAT REF, or '' when REF is absent.
inspect_image() {
  local out
  if out=$(docker image inspect -f "$1" "$2" 2>&1); then found=$out; return 0; fi
  found=''
  out=$(printf '%s\n' "$out" | sed '/^$/d')
  if [ "$out" = "Error response from daemon: No such image: $2" ]; then return 0; fi
  die "docker could not inspect $2: ${out//$'\n'/ | }. Aborting: a failed lookup is not taken for \"absent\", so no tag is created or moved on it; rerun when docker answers"
}
lookup() {  # lookup REF: found = the full image ID REF names, or ''
  inspect_image '{{.Id}}' "$1"
  [ -z "$found" ] || [[ $found =~ ^sha256:[0-9a-f]{64}$ ]] ||
    die "docker image inspect $1 answered '${found//$'\n'/ | }', not an image ID"
}

mark_used() { touch "$STATE/used/$1/$2"; }  # mark_used image|route NAME: a use, now

# --- kicad-route copies ---------------------------------------------------------
# TREE_WALKER (python3 -I -c "$TREE_WALKER" ROOT): one line per entry of ROOT, sorted by
# path: type (f d l o), permission bits (octal), size (0 for d, l, o), content SHA-256
# (f) or symlink target in hex (l) or "-", and the path relative to ROOT in hex. mtimes
# and owners are excluded. An unreadable directory is an error, never a silent skip.
read -r -d '' TREE_WALKER <<'PY' || true
import hashlib, os, stat, sys
root = os.fsencode(sys.argv[1])
out = sys.stdout.buffer
def fail(err):
    raise err
def entry(rel, full):
    st = os.lstat(full)
    m = st.st_mode
    if stat.S_ISREG(m):
        h = hashlib.sha256()
        with open(full, 'rb') as f:
            for chunk in iter(lambda: f.read(1 << 20), b''):
                h.update(chunk)
        kind, size, data = b'f', st.st_size, h.hexdigest().encode()
    elif stat.S_ISLNK(m):
        kind, size, data = b'l', 0, os.readlink(full).hex().encode()
    elif stat.S_ISDIR(m):
        kind, size, data = b'd', 0, b'-'
    else:
        kind, size, data = b'o', 0, b'-'
    out.write(b'%s %o %d %s %s\n' % (kind, stat.S_IMODE(m), size, data, rel.hex().encode()))
paths = []
for top, dirs, files in os.walk(root, onerror=fail):
    for name in dirs + files:
        paths.append(os.path.relpath(os.path.join(top, name), root))
paths.sort()
entry(b'.', root)
for rel in paths:
    entry(rel, os.path.join(root, rel))
PY
# tree_identity IMAGE_ID: tid = the tree identity of /opt/kicad-route in the image, and
# tentries its entry count, computed in one container started from the ID (inside the
# caller's lease) and cached per image ID: an image's content never changes.
tree_identity() {
  local cache=$STATE/tree-id/${1#sha256:} tmp
  tid='' tentries=''
  if [ -s "$cache" ]; then
    read -r tid tentries < "$cache" || true
    [[ $tid =~ ^[0-9a-f]{64}$ ]] && return 0
  fi
  tmp=$(mktemp "$STATE/tmp/tree-XXXXXXXX")
  docker run --rm --network none --user 0:0 "${CONTAINER_LABELS[@]}" \
      "$1" python3 -I -c "$TREE_WALKER" /opt/kicad-route > "$tmp" ||
    { rm -f "$tmp"; die "cannot list /opt/kicad-route in $1"; }
  tid=$(sha256sum < "$tmp" | cut -c1-64); tentries=$(wc -l < "$tmp"); rm -f "$tmp"
  printf '%s %s\n' "$tid" "$tentries" > "$cache.$$"; mv -f "$cache.$$" "$cache"
}
# ensure_copy IMAGE_ID (under locks/tree-TID.lock): when the copy $KR is not ready,
# extract /opt/kicad-route from the image, owned by the caller (the gate's runtime user
# owns it). The extracted tree must have the image's identity before it is published.
# Then refresh its index and verify it offline with that image's own installer check.
ensure_copy() {
  [ -f "$KR.ready" ] && return 0
  rm -rf "$KR" "$KR.partial"; mkdir -p "$KR.partial"
  local cid got
  cid=$(docker create --network none "${CONTAINER_LABELS[@]}" "$1" true)
  docker cp "$cid:/opt/kicad-route" - | tar -x -p -C "$KR.partial" || { docker rm "$cid" >/dev/null; die "cannot extract /opt/kicad-route"; }
  docker rm "$cid" >/dev/null
  got=$(python3 -I -c "$TREE_WALKER" "$KR.partial/kicad-route" | sha256sum | cut -c1-64) ||
    { rm -rf "$KR.partial"; die "cannot compute the identity of the extracted kicad-route tree"; }
  [ "$got" = "$tid" ] ||
    { rm -rf "$KR.partial"; die "the extracted kicad-route tree has identity $got, not the image's $tid"; }
  mv "$KR.partial/kicad-route" "$KR"; rmdir "$KR.partial"
  # Refresh the index stat data for the caller-owned copy, then verify it offline
  # with the image's own installer check, read-only as it is mounted later.
  docker run --rm --network none "${CONTAINER_LABELS[@]}" --user "$(id -u):$(id -g)" -e HOME=/tmp -w / \
    -v "$KR:/opt/kicad-route" "$1" git -C /opt/kicad-route update-index -q --refresh >/dev/null 2>&1 || true
  docker run --rm --network none "${CONTAINER_LABELS[@]}" --user "$(id -u):$(id -g)" -e HOME=/tmp -w / \
    -v "$KR:/opt/kicad-route:ro" "$1" /usr/local/share/agent-ee/kicad-route/install.sh verify >&2 ||
    { rm -rf "$KR"; die "kicad-route copy failed install.sh verify"; }
  printf 'identity %s\nentries %s\nimage %s\nverified %s\n' "$tid" "$tentries" "$1" "$(date -u +%FT%TZ)" > "$KR.ready"
  echo "$prog: new kicad-route copy ${KR##*/} ($tentries entries) from $1, identity checked, verified offline" >&2
}
# claim_copy IMAGE_ID: under gc.lock shared (the caller holds it), find or make the
# verified copy for the image, hold its use lock shared on fd 6 and mark it used. Sets
# tid, tentries and KR.
claim_copy() {
  tree_identity "$1"
  KR=$STATE/kicad-route/tree-$tid
  locked "tree-$tid" ensure_copy "$1"
  exec 6>"$STATE/locks/use-tree-$tid.lock"; flock -s 6
  mark_used route "tree-$tid"
}
# claim_image REF (for --hold and --router-copy): gc.lock shared on fd 7 before the first
# lookup, then, under the image's key lock, resolve REF to its full ID (IMAGE_ID), take the
# image's use lock shared on fd 8 and mark it used. The caller releases fd 7.
claim_image() {
  local key
  take_gc_shared
  lookup "$1"; [ -n "$found" ] || die "no such image: $1"
  IMAGE_ID=$found
  inspect_image '{{index .Config.Labels "ae-ci-exec.inputs"}}' "$IMAGE_ID"
  [[ $found =~ ^[0-9a-f]{64}$ ]] || die "$1 has no ae-ci-exec.inputs label: not an agent-ee build image"
  key=${found:0:16}
  exec 5>"$STATE/locks/image-$key.lock"
  if ! flock -n 5; then echo "$prog: waiting for lock image-$key" >&2; flock 5; fi
  lookup "$IMAGE_ID"; [ "$found" = "$IMAGE_ID" ] || die "image $IMAGE_ID disappeared"
  exec 8>"$STATE/locks/use-image-${IMAGE_ID#sha256:}.lock"; flock -s 8
  exec 5>&-
  mark_used image "${IMAGE_ID#sha256:}"
}

# --- retention ------------------------------------------------------------------
gclog() {  # gclog MESSAGE: to stderr, and (except in a dry run) to logs/gc.log
  echo "$prog: gc: $*" >&2
  [ "$dry" = 1 ] || printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >> "$STATE/logs/gc.log" || true
}
when() { date -u -d "@$1" +%FT%TZ; }
bytes() { numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "$1 B"; }
layers_bytes() {  # the daemon's total image layer bytes (Engine API), or nothing
  local sock=/var/run/docker.sock
  case ${DOCKER_HOST:-} in '') ;; unix://*) sock=${DOCKER_HOST#unix://} ;; *) return 0 ;; esac
  curl -s --max-time 20 --unix-socket "$sock" 'http://localhost/system/df?type=image' 2>/dev/null |
    python3 -I -c 'import json, sys; print(json.load(sys.stdin)["LayersSize"])' 2>/dev/null || true
}
# try_lock FD NAME: take locks/NAME.lock exclusively on FD without waiting; 1 when busy.
try_lock() { eval "exec $1>\"\$STATE/locks/\$2.lock\""; flock -x -n "$1"; }

# other_version: ov = up to three processes that run, or are about to run, an ae-ci-exec
# script whose SHA-256 differs from this one; '' if there are none. Running scripts are
# found by bash's open script descriptor (fd 255), waiting ones by the script path in a
# native-admit command line.
other_version() {
  local p pid t h a n=0
  local -a argv
  ov=''
  for p in /proc/[0-9]*; do
    [ "$n" -lt 3 ] || break
    pid=${p#/proc/}
    [ "$pid" != "$$" ] || continue
    # The -L test (no fork) skips the processes readlink could not read anyway: the scan
    # runs before every removal, and a readlink per process costs seconds on a busy host.
    if [ -L "$p/fd/255" ] && t=$(readlink "$p/fd/255" 2>/dev/null); then
      t=${t% (deleted)}
      if [ "${t##*/}" = ae-ci-exec ]; then
        h=$(sha256sum 2>/dev/null < "$p/fd/255" | cut -c1-64) || h=''
        if [ -n "$h" ] && [ "$h" != "$self_hash" ]; then
          ov+="${ov:+; }pid $pid runs $t (sha256 ${h:0:16})"; n=$(( n + 1 )); continue
        fi
      fi
    fi
    argv=()
    mapfile -d '' -t argv 2>/dev/null < "$p/cmdline" || continue
    [[ " ${argv[*]:0:3} " == *native-admit* ]] || continue
    for a in "${argv[@]}"; do
      [ "${a##*/}" = ae-ci-exec ] && [ -f "$a" ] || continue
      h=$(sha256sum 2>/dev/null < "$a" | cut -c1-64) || h=''
      if [ -n "$h" ] && [ "$h" != "$self_hash" ]; then
        ov+="${ov:+; }pid $pid (native-admit) will start $a (sha256 ${h:0:16})"; n=$(( n + 1 )); break
      fi
    done
  done
}
# containers_now: boxed[ID]=1 for every image a container (running or stopped) uses, and
# mounts = the host paths they mount. A container removed after "docker ps" uses nothing;
# any other inspect error aborts. No temporary file: data and errors are told apart by
# their prefix.
containers_now() {
  local ids out line
  local -a parts
  boxed=() mounts=()
  ids=$(docker ps -a -q --no-trunc) || die "gc: docker ps failed"
  [ -n "$ids" ] || return 0
  # shellcheck disable=SC2086
  out=$(docker container inspect -f 'C {{.Image}}{{range .Mounts}}{{"\t"}}{{.Source}}{{end}}' $ids 2>&1) || true
  while IFS= read -r line; do
    case $line in
      'C '*) IFS=$'\t' read -r -a parts <<< "${line#C }"; boxed[${parts[0]}]=1; mounts+=("${parts[@]:1}") ;;
      ''|'Error response from daemon: No such container: '*) ;;
      *) die "gc: docker container inspect failed: $line" ;;
    esac
  done <<< "$out"
}
# before_removal: right before every destructive step of a pass (each tag removal, each
# copy removal). No other ae-ci-exec version may have started since the last scan, or
# the rest of the pass is abandoned (older versions take no use locks). Then the
# container inventory is read again, so a container that appeared meanwhile is seen.
# gc_main's removed_now holds the tags already removed from the current key or image.
before_removal() {
  if [ "${AE_CI_GC_IGNORE_OLD_VERSIONS:-0}" != 1 ]; then
    other_version
    if [ -n "$ov" ]; then
      gclog "aborted the rest of the pass: another ae-ci-exec version started ($ov); removed so far: heads of $n_keys keys, $n_img images, $n_copy router copies${removed_now:+, and the tags ${removed_now% }}"
      rm -f "$err"
      exit 0
    fi
  fi
  containers_now
}
mounted() {  # mounted DIR: 0 when a container mounts DIR or a path inside it
  local src
  for src in "${mounts[@]}"; do case $src in "$1"|"$1"/*) return 0 ;; esac; done
  return 1
}
# gc_inventory: the agent-ee images and their exec-*/run-* tags. Sets tags[ID] (in-scope
# tags of the image), headkeys[ID] (every key, in scope or not, for which ID is a head),
# key_images[KEY] and key_heads[KEY] (in-scope keys only).
gc_inventory() {
  local out tag id key ishead
  tags=() headkeys=() key_images=() key_heads=()
  out=$(docker images agent-ee --no-trunc --format '{{.Tag}} {{.ID}}') || die "gc: docker images failed"
  while read -r tag id; do
    # Only exec-KEY... and run-KEY... are ours; other agent-ee tags (ci-*, ...) are not touched.
    [[ $tag =~ ^(exec|run)-([0-9a-f]{16})(-.*)?$ ]] || continue
    key=${BASH_REMATCH[2]} ishead=0
    if [[ $tag =~ ^exec-[0-9a-f]{16}(-current)?$ || $tag =~ ^run-[0-9a-f]{16}$ ]]; then
      ishead=1; headkeys[$id]="${headkeys[$id]:-}$key "
    fi
    if [ -n "$GC_KEYS" ] && [[ " $GC_KEYS " != *" $key "* ]]; then continue; fi
    tags[$id]="${tags[$id]:-}$tag "
    [[ " ${key_images[$key]:-} " == *" $id "* ]] || key_images[$key]="${key_images[$key]:-}$id "
    [ "$ishead" = 0 ] || key_heads[$key]="${key_heads[$key]:-}$tag "
  done <<< "$out"
}
# key_rescan KEY: list KEY's tags again (under its lock): key_images[KEY], key_heads[KEY]
# and head_id[TAG], the image each head tag names now.
key_rescan() {
  local out tag id
  key_images[$1]='' key_heads[$1]=''
  out=$(docker images agent-ee --no-trunc --format '{{.Tag}} {{.ID}}') || die "gc: docker images failed"
  while read -r tag id; do
    [[ $tag =~ ^(exec|run)-$1(-.*)?$ ]] || continue
    [[ " ${key_images[$1]} " == *" $id "* ]] || key_images[$1]+="$id "
    if [[ $tag =~ ^exec-$1(-current)?$ || $tag =~ ^run-$1$ ]]; then key_heads[$1]+="$tag "; head_id[$tag]=$id; fi
  done <<< "$out"
}
# key_last_use KEY: key_used = the newest sign of use of KEY in the state directory, or 0:
# a use marker of one of its images (runs, --hold, --router-copy), its build record
# (ae-ci-exec builds), or a build log (logs/build-KEY-* of ae-ci-exec, logs/image-for-KEY-*
# of image_for). A build counts as a use, so tools that write no use markers (image_for,
# ae-ci-exec d988c8d) do not lose the heads of keys they build.
key_last_use() {
  local id f t
  key_used=0
  for id in ${key_images[$1]:-}; do
    f=$STATE/used/image/${id#sha256:}
    [ ! -e "$f" ] || { t=$(stat -c %Y "$f"); [ "$t" -le "$key_used" ] || key_used=$t; }
  done
  for f in "$STATE/builds/$1" "$STATE/logs/build-$1-"*.log "$STATE/logs/image-for-$1-"*.log; do
    [ -e "$f" ] || continue
    t=$(stat -c %Y "$f"); [ "$t" -le "$key_used" ] || key_used=$t
  done
}
# strip_key KEY: from here on KEY's images are no heads of KEY (in a dry run: as if).
strip_key() {
  local id tag k rest
  for id in ${key_images[$1]:-}; do
    [ -n "${tags[$id]+x}" ] || continue
    rest=''; for tag in ${tags[$id]}; do [[ " ${key_heads[$1]} " == *" $tag "* ]] || rest+="$tag "; done
    tags[$id]=$rest
    rest=''; for k in ${headkeys[$id]:-}; do [ "$k" = "$1" ] || rest+="$k "; done
    headkeys[$id]=$rest
  done
}

gc_main() {
  local now horizon head_horizon wait=${AE_CI_GC_WAIT:-60} err=$STATE/tmp/gc-$$.err ov
  local tag id key created used last dir name b f out before after key_used reason late
  local freed=0 n_img=0 n_copy=0 n_keys=0 removed_now=''
  local -A tags=() headkeys=() key_images=() key_heads=() boxed=() created_at=() head_id=()
  local -a mounts=() locknames=() cands=() fresh=()
  other_version
  if [ -n "$ov" ] && [ "${AE_CI_GC_IGNORE_OLD_VERSIONS:-0}" = 1 ]; then
    # Only for tests on private keys (AE_CI_GC_KEYS) and a private state directory.
    gclog "AE_CI_GC_IGNORE_OLD_VERSIONS=1: running although other versions run ($ov)"
    ov=''
  fi
  if [ -n "$ov" ]; then
    if [ "$dry" = 0 ]; then
      gclog "skipped: another ae-ci-exec version is running ($ov); eviction waits until it has drained"
      return 0
    fi
    gclog "a real pass would be skipped now: another ae-ci-exec version is running ($ov)"
  fi
  if [ "$dry" = 0 ]; then
    exec 7>"$STATE/locks/gc.lock"
    if ! flock -x -w "$wait" 7; then
      gclog "skipped: runs are claiming images (gc.lock busy for ${wait}s)"
      return 0
    fi
    # The scan above may be stale after waiting for the lock: scan again.
    if [ "${AE_CI_GC_IGNORE_OLD_VERSIONS:-0}" != 1 ]; then
      other_version
      if [ -n "$ov" ]; then
        gclog "skipped: another ae-ci-exec version started while this pass waited for gc.lock ($ov)"
        return 0
      fi
    fi
    before=$(layers_bytes)
  fi
  now=$(date +%s); horizon=$(( now - KEEP_DAYS * 86400 )); head_horizon=$(( now - KEEP_HEAD_DAYS * 86400 ))
  containers_now
  gc_inventory
  # Heads of stale keys. The snapshot only preselects; a real pass takes the key's lock and
  # reads its tags, freshness, containers and use locks again before it removes anything.
  for key in "${!key_heads[@]}"; do
    key_last_use "$key"
    [ "$key_used" -lt "$head_horizon" ] || continue
    if [ "$dry" = 1 ]; then
      reason=''
      for id in ${key_images[$key]}; do [ -z "${boxed[$id]:-}" ] || reason='a container uses one of its images'; done
      used=$( [ "$key_used" = 0 ] && echo never || when "$key_used")
      if [ -n "$reason" ]; then
        gclog "kept the heads of key $key (last used $used): $reason"
      else
        gclog "would remove the heads of key $key (${key_heads[$key]% }; last used $used), unless a run holds them"
        strip_key "$key"
      fi
      continue
    fi
    if ! try_lock 5 "image-$key"; then
      exec 5>&-; gclog "kept the heads of key $key: a build or run holds its lock"; continue
    fi
    key_rescan "$key"
    key_last_use "$key"
    used=$( [ "$key_used" = 0 ] && echo never || when "$key_used")
    reason=''
    [ -n "${key_heads[$key]}" ] || reason='it has no heads any more'
    [ -n "$reason" ] || [ "$key_used" -lt "$head_horizon" ] || reason="it was used at $used"
    if [ -z "$reason" ]; then
      containers_now
      for id in ${key_images[$key]}; do [ -z "${boxed[$id]:-}" ] || reason='a container uses one of its images'; done
    fi
    if [ -z "$reason" ]; then
      for id in ${key_images[$key]}; do
        try_lock 4 "use-image-${id#sha256:}" || reason='a run or --hold is using one of its images'
        exec 4>&-
        [ -z "$reason" ] || break
      done
    fi
    if [ -n "$reason" ]; then
      exec 5>&-; gclog "kept the heads of key $key (last used $used): $reason"; continue
    fi
    removed_now=''
    for tag in ${key_heads[$key]}; do
      before_removal
      late=''
      for id in ${key_images[$key]}; do [ -z "${boxed[$id]:-}" ] || late='a container started using one of its images'; done
      if [ -n "$late" ]; then gclog "kept the remaining heads of key $key: $late"; reason=$late; break; fi
      lookup "agent-ee:$tag"
      if [ "$found" != "${head_id[$tag]}" ]; then gclog "kept agent-ee:$tag: it changed during the pass"; reason=changed; continue; fi
      if docker rmi "agent-ee:$tag" > /dev/null 2>"$err"; then removed_now+="$tag "; else gclog "kept agent-ee:$tag: $(tr '\n' ' ' < "$err")"; reason=kept; fi
    done
    rm -f "$err"
    if [ -n "$removed_now" ]; then
      n_keys=$(( n_keys + 1 ))
      gclog "removed the heads of key $key (${removed_now% }; last used $used)"
    fi
    removed_now=''
    # Only a key that lost all its heads stops being a head for its images.
    [ -n "$reason" ] || strip_key "$key"
    for id in ${key_images[$key]}; do
      lookup "$id"
      if [ -z "$found" ]; then  # its last tags were these heads
        rm -f "$STATE/used/image/${id#sha256:}" "$STATE/tree-id/${id#sha256:}" "$STATE/locks/use-image-${id#sha256:}.lock"
        tags[$id]=''; n_img=$(( n_img + 1 ))
        gclog "removed image $id with the heads of key $key"
      fi
    done
    exec 5>&-
  done
  # Images: candidates have in-scope tags, are no head of any key and no container uses them.
  for id in "${!tags[@]}"; do
    [ -n "${tags[$id]}" ] && [ -z "${headkeys[$id]:-}" ] && [ -z "${boxed[$id]:-}" ] && cands+=("$id")
  done
  if [ "${#cands[@]}" -gt 0 ]; then
    out=$(docker image inspect -f '{{.Id}} {{.Created}}' "${cands[@]}") || die "gc: docker image inspect failed"
    while read -r id created; do created_at[$id]=$(date -d "$created" +%s); done <<< "$out"
  fi
  for id in "${cands[@]}"; do
    used=0
    [ ! -e "$STATE/used/image/${id#sha256:}" ] || used=$(stat -c %Y "$STATE/used/image/${id#sha256:}")
    created=${created_at[$id]:-0}
    last=$(( created > used ? created : used ))
    [ "$last" -lt "$horizon" ] || continue
    used=$( [ "$used" = 0 ] && echo never || when "$used")
    if [ "$dry" = 1 ]; then
      gclog "would remove image $id (tags ${tags[$id]% }; created $(when "$created"); last used $used), unless a run holds it"
      continue
    fi
    if ! try_lock 5 "use-image-${id#sha256:}"; then
      exec 5>&-; gclog "kept $id: a run or --hold is using it"; continue
    fi
    # Just before removal: the containers, and the image's tags, read again.
    containers_now
    if [ -n "${boxed[$id]:-}" ]; then exec 5>&-; gclog "kept $id: a container started using it"; continue; fi
    lookup "$id"
    if [ -z "$found" ]; then exec 5>&-; continue; fi  # already gone
    inspect_image '{{range .RepoTags}}{{println .}}{{end}}' "$id"
    mapfile -t fresh <<< "$found"
    reason=''
    for tag in "${fresh[@]}"; do
      tag=${tag#agent-ee:}
      if [[ $tag =~ ^exec-[0-9a-f]{16}(-current)?$ || $tag =~ ^run-[0-9a-f]{16}$ ]]; then reason="it became a head ($tag)"; fi
    done
    if [ -n "$reason" ]; then exec 5>&-; gclog "kept $id: $reason"; continue; fi
    removed_now=''
    for tag in ${tags[$id]}; do
      before_removal
      if [ -n "${boxed[$id]:-}" ]; then gclog "kept $id and its remaining tags: a container started using it"; break; fi
      lookup "agent-ee:$tag"
      [ "$found" = "$id" ] || { gclog "kept agent-ee:$tag: it no longer names $id"; continue; }
      if docker rmi "agent-ee:$tag" >/dev/null 2>"$err"; then removed_now+="$tag "; else
        gclog "kept agent-ee:$tag: $(tr '\n' ' ' < "$err")"
      fi
    done
    rm -f "$err"
    # Every removed tag is logged, also when a later one was kept.
    if [ -n "$removed_now" ]; then
      lookup "$id"
      if [ -n "$found" ]; then
        gclog "removed tags ${removed_now% } of $id; the image stays under its other tags"
      else
        rm -f "$STATE/used/image/${id#sha256:}" "$STATE/tree-id/${id#sha256:}" "$STATE/locks/use-image-${id#sha256:}.lock"
        n_img=$(( n_img + 1 ))
        gclog "removed image $id (tags ${removed_now% }; created $(when "$created"); last used $used)"
      fi
    fi
    removed_now=''
    exec 5>&-
  done
  if [ "$n_img" -gt 0 ] && [ -n "${before:-}" ]; then
    after=$(layers_bytes)
    [ -z "$after" ] || gclog "image layers freed: $(bytes $(( before - after )))"
  fi
  # Router copies, all known layouts; other names are left alone.
  for dir in "$STATE"/kicad-route/*; do
    [ -d "$dir" ] || continue
    name=${dir##*/}
    case $name in
      tree-*) [[ ${name#tree-} =~ ^[0-9a-f]{64}$ ]] || continue
              locknames=("tree-${name#tree-}" "use-tree-${name#tree-}") ;;
      sha256-*) [[ ${name#sha256-} =~ ^[0-9a-f]{64}$ ]] || continue
                locknames=("kicad-route-${name#sha256-}") ;;  # d988c8d: keyed by image ID
      *) [[ $name =~ ^[0-9a-f]{16}$ ]] || continue          # before d988c8d: keyed by input KEY
         locknames=("image-$name") ;;
    esac
    ! mounted "$dir" || continue
    last=0
    for f in "$STATE/used/route/$name" "$dir.ready"; do
      [ ! -e "$f" ] || { b=$(stat -c %Y "$f"); [ "$b" -le "$last" ] || last=$b; }
    done
    [ "$last" -gt 0 ] || continue  # neither used nor ready: an extraction, or a broken copy, left alone
    [ "$last" -lt "$horizon" ] || continue
    b=$(du -sb "$dir" | cut -f1)
    if [ "$dry" = 1 ]; then
      gclog "would remove router copy $name ($(bytes "$b"); last used $(when "$last")), unless a run holds it"
      continue
    fi
    if ! try_lock 4 "${locknames[0]}"; then exec 4>&-; gclog "kept copy $name: it is being extracted"; continue; fi
    if [ "${#locknames[@]}" -gt 1 ] && ! try_lock 3 "${locknames[1]}"; then
      exec 3>&- 4>&-; gclog "kept copy $name: a run or --hold is using it"; continue
    fi
    before_removal
    if mounted "$dir"; then exec 3>&- 4>&-; gclog "kept copy $name: a container started mounting it"; continue; fi
    rm -rf "$dir" "$dir.ready" "$STATE/used/route/$name"
    [ "${#locknames[@]}" = 1 ] || rm -f "$STATE/locks/${locknames[1]}.lock"
    freed=$(( freed + b )); n_copy=$(( n_copy + 1 ))
    gclog "removed router copy $name ($(bytes "$b"); last used $(when "$last"))"
    exec 3>&- 4>&-
  done
  if [ "$dry" = 1 ]; then
    gclog "dry run: nothing removed, nothing written"
  else
    gclog "done: heads of $n_keys keys, $n_img images and $n_copy router copies removed ($(bytes "$freed") of copies); keep ${KEEP_DAYS} d, heads ${KEEP_HEAD_DAYS} d"
  fi
}

# --router-copy IMAGE: claim IMAGE, ensure its verified copy, mark both used, print its path.
router_copy_main() {
  claim_image "$image_arg"
  claim_copy "$IMAGE_ID"
  flock -u 7; exec 7>&-
  printf '%s\n' "$KR"
}

# --hold IMAGE [--router] -- COMMAND: run COMMAND while IMAGE (and its copy) is held.
hold_main() {
  local child status=0
  claim_image "$image_arg"
  export AE_CI_IMAGE_ID=$IMAGE_ID
  if [ "$want_router" = 1 ]; then
    claim_copy "$IMAGE_ID"
    export AE_CI_ROUTER_COPY=$KR
  fi
  flock -u 7; exec 7>&-
  echo "$prog: holding $IMAGE_ID${KR:+ and ${KR##*/}} while: $*" >&2
  # COMMAND inherits the use locks on fds 8 and 6, so they last as long as it does.
  "$@" <&0 &
  child=$!
  trap 'kill -TERM "$child" 2>/dev/null' TERM HUP
  trap 'kill -INT "$child" 2>/dev/null' INT
  wait "$child" || status=$?
  while kill -0 "$child" 2>/dev/null; do status=0; wait "$child" || status=$?; done
  mark_used image "${IMAGE_ID#sha256:}"
  [ -z "${KR:-}" ] || mark_used route "${KR##*/}"
  exit "$status"
}

case $mode in
  gc) gc_main; exit 0 ;;
  router-copy) router_copy_main; exit 0 ;;
  hold) hold_main "$@" ;;
esac

# --- CI pins, read from this worktree's workflow (same sed as ci-run.sh) -------
ci_env() { sed -n "s/^ *$1: *\([^ #]*\).*/\1/p" "$wt/.github/workflows/ci.yml" | head -n 1; }
FOME_MC_COMMIT=$(ci_env FOME_MC_COMMIT)
J1_DRAWING_SHA256=$(ci_env J1_DRAWING_SHA256)
J1_DRAWING_URL=$(ci_env J1_DRAWING_URL)
[[ $FOME_MC_COMMIT =~ ^[0-9a-f]{40}$ ]] && [[ $J1_DRAWING_SHA256 =~ ^[0-9a-f]{64}$ ]] ||
  die "cannot read the CI pins from $wt/.github/workflows/ci.yml"

# --- image key: hash of the build inputs ---------------------------------------
# COPY sources other than "." and other than --from stages, relative to the context.
mapfile -t copy_srcs < <(awk 'toupper($1) == "COPY" {
    n = 0; from = 0
    for (i = 2; i <= NF; i++) { if ($i ~ /^--from=/) from = 1; else if ($i !~ /^--/) a[++n] = $i }
    if (!from) for (i = 1; i < n; i++) if (a[i] != ".") print a[i]
  }' "$wt/Dockerfile" | sort -u)
inputs=(Dockerfile)
for s in "${copy_srcs[@]}"; do
  [[ $s != /* && $s != *..* ]] || die "unsupported COPY source $s"
  [ -e "$wt/$s" ] || die "COPY source $s missing in $wt"
  while IFS= read -r -d '' f; do inputs+=("${f#./}"); done < <(cd "$wt" && find "./$s" -type f -print0)
done
mapfile -t inputs < <(printf '%s\n' "${inputs[@]}" | LC_ALL=C sort -u)
# One line per file: path, executable bit, content hash. Git checkouts differ only
# in umask, so only the executable bit is kept (the context uses 775/664 like git archive).
hash_line() { local x=0; [ -x "$wt/$1" ] && x=1; printf '%s %s %s\n' "$1" "$x" "$(sha256sum < "$wt/$1" | cut -c1-64)"; }
input_hash=$(for f in "${inputs[@]}"; do hash_line "$f"; done | sha256sum | cut -c1-64)
KEY=${input_hash:0:16}
CURRENT=agent-ee:exec-$KEY-current  # moved by each successful build of this version
LEGACY=agent-ee:exec-$KEY           # created when missing, never moved, never selected
BUILDS=$STATE/builds/$KEY
# The remote files the build rechecks (for the fallback warning).
mapfile -t remote_adds < <(awk 'toupper($1) == "ADD" { for (i = 2; i <= NF; i++) if ($i ~ /^https?:\/\//) print $i }' "$wt/Dockerfile")

# The build record for KEY, replaced by rename and written only under the image lock, so a
# reader without the lock sees whole lines.
#   line 1 "GEN STATUS INPUT_HASH IMAGE FINISHED LOG": the latest build. STATUS is built or
#     failed, IMAGE is "-" for failed, FINISHED is epoch seconds. GEN is 0 without a record.
#   line 2 "checked INPUT_HASH IMAGE EPOCH": the last successful upstream check, the start
#     of the build that succeeded, and the image it produced. A failed build keeps it.
#     Versions before the refresh window read only line 1 and drop line 2 when they write;
#     the next run of this version then checks again.
read_build() {
  rec_gen=0 rec_status='' rec_inputs='' rec_image='' rec_finished='' rec_log=''
  chk_inputs='' chk_image='' chk_time=0
  local chk_tag=''
  if [ -f "$BUILDS" ]; then
    { read -r rec_gen rec_status rec_inputs rec_image rec_finished rec_log || true
      read -r chk_tag chk_inputs chk_image chk_time _ || true; } < "$BUILDS"
  fi
  [[ $rec_gen =~ ^[0-9]+$ ]] || rec_gen=0
  if [ "$chk_tag" != checked ] || ! [[ $chk_time =~ ^[0-9]+$ ]]; then chk_inputs='' chk_image='' chk_time=0; fi
}
record_build() {  # record_build STATUS IMAGE LOG [CHECKED]: the next generation; CHECKED = a successful check
  read_build
  {
    printf '%s %s %s %s %s %s\n' "$(( rec_gen + 1 ))" "$1" "$input_hash" "$2" "$(date +%s)" "$3"
    if [ -n "${4:-}" ]; then
      printf 'checked %s %s %s\n' "$input_hash" "$2" "$4"
    elif [ -n "$chk_inputs" ]; then
      printf 'checked %s %s %s\n' "$chk_inputs" "$chk_image" "$chk_time"
    fi
  } > "$BUILDS.$$"
  mv -f "$BUILDS.$$" "$BUILDS"
}

# lookup_labelled REF: found = the ID of the image REF names, if that image is labelled
# with these exact inputs; '' otherwise. Used for the fallback candidate ($CURRENT) and
# the one-time seed of $CURRENT from $LEGACY.
lookup_labelled() {
  local ref_id
  lookup "$1"; ref_id=$found
  [ -n "$ref_id" ] || return 0
  inspect_image '{{index .Config.Labels "ae-ci-exec.inputs"}}' "$ref_id"
  if [ "$found" = "$input_hash" ]; then found=$ref_id; else found=''; fi
}

pin() {  # pin ID: give the image its own tag agent-ee:exec-KEY-<first 12 hex of ID>, never moved
  local tag=agent-ee:exec-$KEY-${1:7:12}
  lookup "$tag"
  if [ -z "$found" ]; then docker tag "$1" "$tag"
  elif [ "$found" != "$1" ]; then die "$tag names $found, not $1"; fi
}

# build_image DEFAULT_ATTEMPTS: one BuildKit build of the inputs, tried BUILD_ATTEMPTS or
# DEFAULT_ATTEMPTS times for transient mirror errors. A successful build loads its image
# as $CURRENT, which moves that tag. Sets build_ok (1 or 0), build_id, build_log and
# build_checked (the start of the successful attempt). Not called as a condition, so
# set -e stays in force inside.
build_image() {
  local ctx=$STATE/ctx/$KEY.$$ f start n=1 attempts=${BUILD_ATTEMPTS:-$1} delay=30
  build_ok=0 build_id='' build_checked='' build_log=$STATE/logs/build-$KEY-$(date -u +%Y%m%dT%H%M%SZ).log
  rm -rf "$ctx" "$ctx.iid"; mkdir -p "$ctx"
  for f in "${inputs[@]}"; do
    mkdir -p "$ctx/$(dirname "$f")"; cp "$wt/$f" "$ctx/$f"
    if [ -x "$wt/$f" ]; then chmod 775 "$ctx/$f"; else chmod 664 "$ctx/$f"; fi
  done
  # Recheck the copied bytes against the hash (the worktree is live).
  [ "$(cd "$ctx" && for f in "${inputs[@]}"; do x=0; [ -x "$f" ] && x=1; printf '%s %s %s\n' "$f" "$x" "$(sha256sum < "$f" | cut -c1-64)"; done | sha256sum | cut -c1-64)" = "$input_hash" ] ||
    { rm -rf "$ctx"; die "build inputs changed while copying; retry"; }
  echo "$prog: building $CURRENT from $wt (up to $attempts attempts; log $build_log)" >&2
  while :; do
    start=$(date +%s)
    if docker buildx build --builder default --progress=plain --load --iidfile "$ctx.iid" \
        --label ae-ci-exec.inputs="$input_hash" -t "$CURRENT" "$ctx" >>"$build_log" 2>&1; then
      build_ok=1
      break
    fi
    # Mirror 503s fail a layer; BuildKit keeps finished layers, so a retry resumes.
    if [ "$n" -ge "$attempts" ]; then
      tail -n 30 "$build_log" >&2
      echo "=== build failed after $n of $attempts attempts" | tee -a "$build_log" >&2
      break
    fi
    echo "$prog: build attempt $n of $attempts failed; retrying in ${delay}s (log $build_log)" >&2
    sleep "$delay"; delay=$(( delay * 2 > 600 ? 600 : delay * 2 )); n=$(( n + 1 ))
  done
  build_id=$(cat "$ctx.iid" 2>/dev/null || true)
  rm -rf "$ctx" "$ctx.iid"
  [ "$build_ok" = 1 ] || return 0
  [[ $build_id =~ ^sha256:[0-9a-f]{64}$ ]] || die "the build reported no image ID (log $build_log)"
  lookup "$CURRENT"
  [ "$found" = "$build_id" ] || die "$CURRENT does not name the image just built, $build_id (log $build_log)"
  build_checked=$start
  echo "=== built $CURRENT = $build_id in $(( $(date +%s) - start ))s (attempt $n of $attempts)" | tee -a "$build_log" >&2
}

# fallback WHY LOG: every attempt of a build failed (this run's, or the build it waited
# for). Set id to the image exec-KEY-current names, if it is labelled with these exact
# inputs, and say so loudly; otherwise fail as before.
fallback() {
  local created url
  lookup_labelled "$CURRENT"; id=$found
  [ -n "$id" ] || die "$1, and no image for these inputs exists ($CURRENT); build log $2"
  inspect_image '{{.Created}}' "$id"; created=$found
  {
    echo "$prog: WARNING ======================================================================"
    echo "$prog: WARNING: $1 (build log $2),"
    echo "$prog: WARNING: so this run's image was NOT refreshed. It uses the existing image"
    echo "$prog: WARNING:   $id ($CURRENT), created $created."
    echo "$prog: WARNING: That image may lag newer upstream releases. This build did not finish"
    echo "$prog: WARNING: rechecking the remote ADDs below or did not build their result:"
    for url in "${remote_adds[@]}"; do echo "$prog: WARNING:   $url"; done
    echo "$prog: WARNING ======================================================================"
  } >&2
  [ -z "$2" ] || echo "=== run $$ fell back to $id (created $created)" >> "$2" || true
}

# resolve_image ASKED_GEN RESULT: under the image lock, choose this run's image and write
# "ID HOW" to RESULT.
# How concurrent callers stay consistent:
#   - Only holders of locks/image-KEY.lock build, read exec-KEY-current or move it, so a
#     run never sees it half-moved. The build moves it when it loads its image. Before
#     that, the image it named is pinned under its own tag, so it stays reachable.
#   - exec-KEY, the tag older versions and image_for use, is never moved. It is created
#     when missing, after a successful build, and it is read once to seed a missing
#     exec-KEY-current (label-checked). That kept callers of versions before d988c8d on
#     the image they resolved; that transition is over. Eviction removes it only with
#     the other heads of a stale key.
#   - A run reads the record's GEN (ASKED_GEN) before it asks for any lock. If GEN has
#     grown when the run gets the image lock, a build for KEY finished while the run
#     waited, and the run takes that build's outcome instead of building again. Callers
#     that start together therefore share one build: the first builds, the others wait
#     and reuse its image, or share its failure. A run that starts after a build has
#     finished builds again, which rechecks upstream, unless the refresh window applies.
#   - Refresh window: when exec-KEY-current existed when the run got the lock, and the
#     record's last successful check is for these inputs, produced the image -current
#     still names, and is younger than AE_CI_REFRESH_HOURS, the run reuses -current
#     without building.
#   - image_for builds under the same lock but writes no record. A run that waited for it
#     builds again, from the cache.
#   - The chosen image gets its never-moved tag (pin) before the lock is released, so it
#     stays tagged for retention. After that, the run uses only its full image ID.
resolve_image() {
  local asked=$1 result=$2 id='' how='' prev seed had now age
  read_build
  if [ "$rec_gen" -gt "$asked" ] && [ "$rec_inputs" = "$input_hash" ]; then
    found=''
    if [ "$rec_status" = built ]; then lookup "$rec_image"; fi
    if [ "$rec_status" = built ] && [ "$found" = "$rec_image" ]; then
      echo "$prog: reusing $rec_image from the build that finished while this run waited (log $rec_log)" >&2
      id=$rec_image how=reused
    elif [ "$rec_status" = failed ]; then
      echo "$prog: the build this run waited for failed; its last lines (log $rec_log):" >&2
      grep -v '^=== ' "$rec_log" 2>/dev/null | tail -n 10 >&2 || true
      fallback "the build this run waited for failed" "$rec_log"
      how=fallback
    fi
  fi
  if [ -z "$id" ]; then
    lookup "$CURRENT"; had=$found
    if [ -n "$had" ] && [ "$REFRESH_HOURS" -gt 0 ] && [ "$chk_inputs" = "$input_hash" ] && [ "$chk_image" = "$had" ]; then
      now=$(date +%s); age=$(( now - chk_time ))
      if [ "$age" -ge 0 ] && [ "$age" -lt $(( REFRESH_HOURS * 3600 )) ]; then
        echo "$prog: reusing $CURRENT = $had without a build: upstream last checked $(when "$chk_time"), $(( age / 3600 ))h $(( age % 3600 / 60 ))m ago; the next run after $(when $(( chk_time + REFRESH_HOURS * 3600 ))) checks again (AE_CI_REFRESH_HOURS=$REFRESH_HOURS)" >&2
        id=$had how=window
      fi
    fi
  fi
  if [ -z "$id" ]; then
    # The first run of this version for KEY seeds exec-KEY-current, once, from the image
    # exec-KEY names, if that image is labelled with these exact inputs. That gives the
    # run an image to fall back to. exec-KEY itself is not moved.
    if [ -z "$had" ]; then
      lookup_labelled "$LEGACY"; seed=$found
      if [ -n "$seed" ]; then
        docker tag "$seed" "$CURRENT"
        echo "$prog: seeded $CURRENT from $LEGACY: $seed" >&2
      fi
    fi
    lookup "$CURRENT"; prev=$found
    [ -z "$prev" ] || pin "$prev"
    # With an image to fall back to, keep an outage short: 2 attempts, one 30 s backoff.
    # Without one the run cannot go on, so it retries longer: 6 attempts.
    lookup_labelled "$CURRENT"
    if [ -n "$found" ]; then build_image 2; else build_image 6; fi
    if [ "$build_ok" = 1 ]; then
      record_build built "$build_id" "$build_log" "$build_checked"
      # Older versions and image_for know only exec-KEY: create it once, never move it.
      lookup "$LEGACY"
      [ -n "$found" ] || docker tag "$build_id" "$LEGACY"
      id=$build_id how=built
    else
      record_build failed - "$build_log"
      fallback "the image build failed" "$build_log"
      how=fallback
    fi
  fi
  pin "$id"
  printf '%s %s\n' "$id" "$how" > "$result"
}

# Required inputs share this executable custody boundary with the pure checks.
source "$(dirname "$self")/native-input-fetch.sh"

input_opts=()
input_receipt=
input_manifest=${AE_CI_INPUT_MANIFEST:-}
if [ -n "${AE_CI_INPUT_MANIFEST+x}" ]; then
  [ -f "$input_manifest" ] || die "native input manifest not found: $input_manifest"
  [ -n "${AE_CI_EVIDENCE_DIR:-}" ] || die "AE_CI_INPUT_MANIFEST requires AE_CI_EVIDENCE_DIR for durable inputs and outputs"
  case $AE_CI_EVIDENCE_DIR in /*) ;; *) die "AE_CI_EVIDENCE_DIR must be an absolute path" ;; esac
  input_helper=$(dirname "$self")/native-inputs.py
  [ -f "$input_helper" ] || die "native-inputs.py is not installed beside $self"
  input_plan=$(python3 "$input_helper" prepare "$input_manifest" --evidence-dir "$AE_CI_EVIDENCE_DIR" \
    --runner "$self" --source "$wt")
  input_receipt=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["receipt"])' <<< "$input_plan")
  input_args=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["args_file"])' <<< "$input_plan")
  mapfile -d '' -t input_opts < "$input_args"
fi

# --- claim this run's image and router copy (see Retention in the header) -------
# gc.lock is held shared from before the image is resolved until both use locks are held,
# so an eviction never runs between the choice of an image or copy and its protection.
take_gc_shared
read_build
asked_gen=$rec_gen  # before any lock wait: see resolve_image
locked "inputs" fetch_inputs
required_input_mounts
resolved=$STATE/tmp/image-$$
trap 'rm -f "$resolved"' EXIT
resolve_start=$SECONDS
locked "image-$KEY" resolve_image "$asked_gen" "$resolved"
IMAGE_ID='' image_how=''
read -r IMAGE_ID image_how < "$resolved" || true
rm -f "$resolved"; trap - EXIT
[[ $IMAGE_ID =~ ^sha256:[0-9a-f]{64}$ ]] || die "no image resolved"
exec 8>"$STATE/locks/use-image-${IMAGE_ID#sha256:}.lock"; flock -s 8
mark_used image "${IMAGE_ID#sha256:}"
echo "$prog: image $IMAGE_ID (agent-ee:exec-$KEY-${IMAGE_ID:7:12}, $image_how, resolved in $(( SECONDS - resolve_start ))s)" >&2
[ -z "$input_receipt" ] || python3 "$input_helper" bind-image "$input_receipt" "$IMAGE_ID"
claim_copy "$IMAGE_ID"
flock -u 7; exec 7>&-
echo "$prog: kicad-route copy $KR" >&2

# --- sandbox options (ci.yml "Permit container user namespaces") ---------------
if [ "$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2>/dev/null || echo 0)" != 0 ]; then
  die "kernel.apparmor_restrict_unprivileged_userns=1 blocks bwrap in the container; set it to 0 (shared/agent-ee/README.md)"
fi
SANDBOX_OPTS=(--network none --security-opt seccomp=unconfined --security-opt apparmor=unconfined
              --security-opt systempaths=unconfined)
# Admission bounds: CPU quota scaled to the lease weight, a PID cap, and an init that
# reaps orphaned bwrap children. Images from agent-ee 7e5bdc46 on (AGENTEE-459) run
# tini as their ENTRYPOINT; older images get docker's own init (--init).
LIMIT_OPTS=()
[ -z "${NATIVE_ADMISSION_CPUS:-}" ] || LIMIT_OPTS+=(--cpus "$NATIVE_ADMISSION_CPUS")
[ -z "${NATIVE_ADMISSION_PIDS:-}" ] || LIMIT_OPTS+=(--pids-limit "$NATIVE_ADMISSION_PIDS")
inspect_image '{{json .Config.Entrypoint}}' "$IMAGE_ID"
[[ $found == *tini* ]] || LIMIT_OPTS+=(--init)

scratch=$(mktemp -d "$STATE/tmp/run-XXXXXXXX")
name=ae-ci-exec-$(basename "$scratch" | tr 'A-Z' 'a-z')
# Git metadata outside the worktree: a linked worktree's gitdir and common dir,
# and object alternates, at their host paths.
git_mounts=() gitfile=
if [ -e "$wt/.git" ] && command -v git >/dev/null; then
  if mapfile -t gd < <(git -C "$wt" rev-parse --path-format=absolute --git-dir --git-common-dir 2>/dev/null) &&
     [ "${#gd[@]}" = 2 ]; then
    git_dir=${gd[0]} common_dir=${gd[1]}
    if [ -f "$wt/.git" ]; then
      git_mounts+=(-v "$common_dir:$common_dir:ro")
      [ "$git_dir" = "$common_dir" ] || git_mounts+=(-v "$git_dir:$git_dir")
      # The gitfile may hold a relative path; name the gitdir absolutely.
      gitfile=$scratch.gitfile
      printf 'gitdir: %s\n' "$git_dir" > "$gitfile"
      git_mounts+=(-v "$gitfile:/opt/agent-ee/.git:ro")
    fi
    if [ -f "$common_dir/objects/info/alternates" ]; then
      while IFS= read -r alt; do
        [ -n "$alt" ] && [ "${alt#\#}" = "$alt" ] || continue
        [[ $alt = /* ]] || alt=$(realpath -m "$common_dir/objects/$alt")
        case $alt in "$wt"|"$wt"/*|"$common_dir"|"$common_dir"/*) ;; *) git_mounts+=(-v "$alt:$alt:ro") ;; esac
      done < "$common_dir/objects/info/alternates"
    fi
  else
    echo "$prog: warning: git cannot read $wt/.git; git commands in the container will fail" >&2
  fi
fi
env_opts=(-e AGENT_EE_REQUIRE_TOOLCHAIN=1 -e PYTHONPATH=src -e HOME=/tmp -e TMPDIR=/tmp
          -e AGENT_EE_FOME_MC_CHECKOUT=/opt/fome-mc -e AGENT_EE_J1_DRAWING=/opt/j1/te-776228-1.pdf)
[ -z "${AGENT_EE_SKIP_VISUALS+x}" ] || env_opts+=(-e "AGENT_EE_SKIP_VISUALS=$AGENT_EE_SKIP_VISUALS")
tty=(-i); [ -t 0 ] && [ -t 1 ] && tty=(-i -t)
# AE_CI_TMPFS=SIZE (e.g. 8g): the per-run /tmp scratch is a memory-backed tmpfs capped
# at SIZE instead of a disk directory. Only for nondurable scratch: receipts, logs and
# summaries a command writes into the worktree stay on disk. AE_CI_KEEP_TMP cannot
# keep a tmpfs.
scratch_mount=(-v "$scratch:/tmp")
if [ -n "${AE_CI_TMPFS:-}" ]; then
  [[ $AE_CI_TMPFS =~ ^[0-9]+[kmg]?$ ]] || die "AE_CI_TMPFS must be a size like 8g"
  scratch_mount=(--mount "type=tmpfs,destination=/tmp,tmpfs-size=$AE_CI_TMPFS,tmpfs-mode=1777")
  [ "${AE_CI_KEEP_TMP:-0}" != 1 ] || echo "$prog: AE_CI_KEEP_TMP ignored with AE_CI_TMPFS" >&2
fi

cleanup() {
  docker kill "$name" >/dev/null 2>&1 || true
  [ -z "$gitfile" ] || rm -f "$gitfile"
  if [ "${AE_CI_KEEP_TMP:-0}" = 1 ]; then echo "$prog: kept scratch $scratch" >&2; else rm -rf "$scratch"; fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP


if [ -n "${AE_CI_OUTCOME_FILE:-}" ]; then
  python3 "$(dirname "$self")/ae-ci-outcome.py" mark-started "$AE_CI_OUTCOME_FILE"
fi
status=0
docker run --rm --name "$name" "${CONTAINER_LABELS[@]}" "${tty[@]}" "${SANDBOX_OPTS[@]}" "${LIMIT_OPTS[@]}" \
  --user "$(id -u):$(id -g)" "${env_opts[@]}" "${input_opts[@]}" \
  -v "$wt:/opt/agent-ee" "${git_mounts[@]}" "${scratch_mount[@]}" \
  "${REQUIRED_INPUT_MOUNTS[@]}" \
  -v "$KR:/opt/kicad-route:ro" \
  -w /opt/agent-ee "$IMAGE_ID" "$@" <&0 &
wait $! || status=$?
# Eviction (see Retention): a separate process, so its errors never change the status.
# This run still holds its use locks, so its own image and copy are kept.
if [ "${AE_CI_AUTO_GC:-1}" != 0 ]; then
  AE_CI_GC_WAIT=0 "$self" --gc || echo "$prog: gc failed (exit $?); the run's exit status is unaffected" >&2
fi
exit "$status"
