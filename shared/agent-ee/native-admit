#!/usr/bin/env python3
"""native-admit: host-wide admission for native agent-ee/KiCad work.

  native-admit run --weight N --label TEXT [--class suite|test] [--max-wait S] -- COMMAND [ARG...]
  native-admit status [--json]
  native-admit sample [--print]
  native-admit reserve --label TEXT --minutes N      # hold the host for one controlled comparison
  native-admit unreserve
  native-admit drain --reason TEXT [--suites-only]   # admit nothing new (or no new suites)
  native-admit undrain

A lease is a file under $STATE/leases that the admitted command holds with an
exclusive flock. The descriptor is inherited by COMMAND and its children, so the
lease ends when they all exit, however they exit (crash, kill -9, cancel). Every
admission decision runs under $STATE/mutex.lock: it removes leases and queue
entries whose flock is free (dead holders), then admits the head of the FIFO
queue only if

  weight <= max_weight             (else refused at once, exit 1: no silent clamping; up to
                                    reserved_max_weight only for the holder of the host reservation)
  PSI is readable                  (unknown pressure queues like unknown capacity)
  capacity is known                (docker ps answered; otherwise queue)
  the host is not draining         (drain.json; --suites-only drains suites only)
  used + weight <= budget          (or nothing is running at all)
  suites + 1 <= max_suites         (for --class suite)
  CPU and I/O pressure (PSI some avg10) are under their limits, when work is running
  no reservation is active, or the request holds it (NATIVE_ADMISSION_RESERVATION)

"used" counts live leases plus agent-ee containers that hold no live lease
(started before admission existed, or orphaned by a killed client), weighted by
their actual strict_suite --jobs (unclamped). Model sessions are not leases; only native work is.

Config: ~/.config/native-admission/config.json (per host, from infra
shared/agent-ee/native-admission.json). State: ~/.local/state/native-admission/
(NATIVE_ADMISSION_HOME overrides both, for tests). Canonical source: infra
shared/agent-ee/.
"""
import argparse
import datetime
import fcntl
import json
import os
import re
import socket
import subprocess
import sys
import time
import uuid
from pathlib import Path

HOME = Path(os.environ.get("NATIVE_ADMISSION_HOME", Path.home() / ".local/state/native-admission"))
CONFIG = (HOME / "config.json") if "NATIVE_ADMISSION_HOME" in os.environ else \
    Path.home() / ".config/native-admission/config.json"
POLL = 5


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")


def config():
    n = os.cpu_count() or 1
    cfg = {"budget": max(1, n // 3), "max_weight": 4, "max_suites": 1, "cpu_psi_max": 50.0,
           "io_psi_max": 30.0, "pids_limit": 16384, "docker": True, "enforce": True}
    if CONFIG.is_file():
        cfg.update(json.loads(CONFIG.read_text()))
    cfg.setdefault("cpus_per_unit", round(n / cfg["budget"], 2))
    return cfg


def log_event(kind, **fields):
    HOME.mkdir(parents=True, exist_ok=True)
    with open(HOME / "events.jsonl", "a") as f:
        f.write(json.dumps({"ts": now(), "event": kind, **fields}) + "\n")


def psi(resource):
    """some avg10 for cpu/io/memory, or None when the kernel does not report it."""
    try:
        for line in Path(f"/proc/pressure/{resource}").read_text().splitlines():
            if line.startswith("some"):
                return float(dict(kv.split("=") for kv in line.split()[1:])["avg10"])
    except (OSError, KeyError, ValueError):
        pass
    return None


def is_dead(path):
    """True when nobody holds the file's flock (its holder exited)."""
    try:
        fd = os.open(path, os.O_RDONLY)
    except FileNotFoundError:
        return True
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except BlockingIOError:
        return False
    finally:
        os.close(fd)


def read_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def live(kind):
    """Live entries of leases/ or queue/, removing dead ones (call under the mutex)."""
    out = []
    d = HOME / kind
    d.mkdir(parents=True, exist_ok=True)
    for path in d.glob("*.json"):
        info = read_json(path)
        if is_dead(path):
            path.unlink(missing_ok=True)
            if kind == "leases":
                log_event("released", lease=info.get("id"), label=info.get("label"), weight=info.get("weight"),
                          held_s=int(time.time() - info.get("t", time.time())))
            continue
        out.append(info)
    return sorted(out, key=lambda x: x.get("seq", 0))


def inherited_lease():
    """The lease named by NATIVE_ADMISSION_LEASE, if this process holds an inherited descriptor
    on that lease file and the lease is live; else None. Descriptors are inherited only from the
    admitted process, so this proves ancestry, unlike trusting the environment."""
    lease = os.environ.get("NATIVE_ADMISSION_LEASE", "")
    if not re.fullmatch(r"[0-9a-f]{12}", lease):
        return None
    path = (HOME / "leases" / f"{lease}.json").resolve()
    held = False
    for fd in Path("/proc/self/fd").iterdir():
        try:
            held = held or Path(os.readlink(fd)) == path
        except OSError:
            pass
    return lease if held and not is_dead(path) else None


def verify(_):
    lease = inherited_lease()
    if not lease:
        sys.exit("native-admit: no inherited live lease")
    print(lease)


def job_weight(args, cfg):
    """Requested weight and class: strict_suite --jobs N is a suite of N workers (its default is the
    CPU count), ci-run.sh is a suite of $JOBS (default 4), anything else a test of 1."""
    text = " ".join(args)
    if "strict_suite" in text:
        m = re.search(r"--jobs[= ](\d+)", text)
        return (int(m.group(1)) if m else os.cpu_count() or 1), "suite"
    if "ci-run.sh" in text:
        return int(os.environ.get("JOBS", "4")), "suite"
    return 1, "test"


def containers(cfg, leases):
    """Running agent-ee containers that hold no live lease."""
    if not cfg["docker"]:
        return []
    fmt = '{{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Label "native-admission.lease"}}\t{{.Command}}'
    try:
        out = subprocess.run(["docker", "ps", "--no-trunc", "--format", fmt], capture_output=True,
                             text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None  # unknown capacity: callers queue instead of assuming an idle host
    held = {lease.get("id") for lease in leases}
    found = []
    for line in out.stdout.splitlines():
        cid, name, image, lease, command = (line.split("\t") + [""] * 5)[:5]
        if not image.startswith("agent-ee:") or (lease and lease in held):
            continue
        weight, klass = job_weight([command], cfg)
        found.append({"name": name, "image": image, "weight": weight, "class": klass})
    return found


def usage(cfg):
    leases = live("leases")
    extra = containers(cfg, leases)
    if extra is None:
        return leases, None, None, None
    used = sum(x["weight"] for x in leases) + sum(x["weight"] for x in extra)
    suites = sum(x["class"] == "suite" for x in leases + extra)
    return leases, extra, used, suites


class Mutex:
    def __enter__(self):
        HOME.mkdir(parents=True, exist_ok=True)
        self.fd = os.open(HOME / "mutex.lock", os.O_RDWR | os.O_CREAT, 0o644)
        fcntl.flock(self.fd, fcntl.LOCK_EX)

    def __exit__(self, *exc):
        os.close(self.fd)


def reservation():
    path = HOME / "reservation.json"
    info = read_json(path)
    if info and info.get("until", 0) < time.time():
        path.unlink(missing_ok=True)
        log_event("reservation-expired", label=info.get("label"))
        return {}
    return info


def hold(directory, info):
    """Create directory/<id>.json holding its flock; the descriptor stays open (inheritable)."""
    path = HOME / directory / f"{info['id']}.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_TRUNC, 0o644)
    fcntl.flock(fd, fcntl.LOCK_EX)
    os.write(fd, json.dumps(info).encode())
    return fd, path


def blocked(cfg, info):
    """Reason the request cannot start now, or None. Call under the mutex."""
    queue = live("queue")
    ahead = [q for q in queue if q["seq"] < info["seq"]]
    if ahead:
        return f"queued behind {len(ahead)}"
    res = reservation()
    if res and res.get("token") != os.environ.get("NATIVE_ADMISSION_RESERVATION"):
        return f"host reserved for {res.get('label')!r}"
    drain = read_json(HOME / "drain.json")
    if drain and (not drain.get("suites_only") or info["class"] == "suite"):
        return f"host draining: {drain.get('reason')}"
    leases, extra, used, suites = usage(cfg)
    if extra is None:
        return "capacity unknown: docker ps failed"
    if used and used + info["weight"] > cfg["budget"]:
        return f"budget {used}+{info['weight']} > {cfg['budget']}"
    if info["class"] == "suite" and suites >= cfg["max_suites"]:
        return f"{suites} suite(s) running, max {cfg['max_suites']}"
    if used:
        cpu, io = psi("cpu"), psi("io")
        if cpu is None or io is None:
            return "pressure unknown: /proc/pressure unreadable"
        if cpu > cfg["cpu_psi_max"]:
            return f"CPU pressure {cpu} > {cfg['cpu_psi_max']}"
        if io > cfg["io_psi_max"]:
            return f"I/O pressure {io} > {cfg['io_psi_max']}"
    return None


def run(args):
    cfg = config()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        sys.exit("native-admit: no command")
    if inherited_lease():
        os.execvp(command[0], command)  # already inside an admitted job (descriptor proves it)
    weight, klass = job_weight(command, cfg)
    weight = args.weight if args.weight is not None else weight
    klass = args.klass or klass
    res = reservation()
    holds = bool(res) and res.get("token") == os.environ.get("NATIVE_ADMISSION_RESERVATION")
    allowed = cfg.get("reserved_max_weight", cfg["max_weight"]) if holds else cfg["max_weight"]
    if weight > allowed:
        log_event("refused", label=args.label or " ".join(command)[:120], weight=weight, max_weight=cfg["max_weight"])
        extra = (f"; up to {cfg['reserved_max_weight']} only while holding this host's reservation"
                 if cfg.get("reserved_max_weight", 0) > cfg["max_weight"] else "")
        sys.exit(f"native-admit: refused: weight {weight} exceeds this host's max_weight {cfg['max_weight']}{extra} "
                 f"(pass strict_suite --jobs <= {cfg['max_weight']}, or JOBS for ci-run.sh)")
    info = {"id": uuid.uuid4().hex[:12], "seq": time.time_ns(), "label": args.label or " ".join(command)[:120],
            "weight": weight, "class": klass, "pid": os.getpid(), "cwd": os.getcwd(), "t": time.time(),
            "started": now(), "host": socket.gethostname()}
    if not cfg["enforce"]:
        log_event("unenforced", label=info["label"], weight=weight)
        os.execvp(command[0], command)
    with Mutex():
        qfd, qpath = hold("queue", info)
    start, said, reason = time.time(), 0.0, None
    while True:
        with Mutex():
            reason = blocked(cfg, info)
            if reason is None:
                fd, _ = hold("leases", info)
                qpath.unlink(missing_ok=True)
                os.close(qfd)
                break
        waited = time.time() - start
        if args.max_wait is not None and waited >= args.max_wait:
            log_event("gave-up", label=info["label"], weight=weight, waited_s=int(waited), reason=reason)
            print(f"native-admit: not admitted after {int(waited)}s ({reason})", file=sys.stderr)
            sys.exit(75)
        if waited - said >= 300 or said == 0:
            print(f"native-admit: waiting: {reason} (weight {weight}, {int(waited)}s; `native-admit status`)",
                  file=sys.stderr)
            said = waited or 0.001
        time.sleep(POLL)
    waited = int(time.time() - start)
    log_event("admitted", lease=info["id"], label=info["label"], weight=weight, klass=klass, waited_s=waited,
              seq=info["seq"])
    if waited:
        print(f"native-admit: admitted after {waited}s (lease {info['id']}, weight {weight})", file=sys.stderr)
    os.set_inheritable(fd, True)
    os.environ.update(NATIVE_ADMISSION_LEASE=info["id"], NATIVE_ADMISSION_WEIGHT=str(weight),
                      NATIVE_ADMISSION_CPUS=str(round(min(weight * cfg["cpus_per_unit"], os.cpu_count() or 1), 2)),
                      NATIVE_ADMISSION_PIDS=str(cfg["pids_limit"]))
    os.execvp(command[0], command)


def container_details(cfg):
    """PID 1, init and limits of running agent-ee containers (for monitors), or None if docker is unavailable."""
    if not cfg["docker"]:
        return []
    try:
        ids = subprocess.run(["docker", "ps", "-q"], capture_output=True, text=True, timeout=30)
        if ids.returncode != 0:
            return None
        if not ids.stdout.split():
            return []
        out = subprocess.run(["docker", "inspect", *ids.stdout.split()], capture_output=True, text=True, timeout=60)
        items = json.loads(out.stdout) if out.returncode == 0 else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    if items is None:
        return None
    found = []
    for c in items:
        if not c["Config"]["Image"].startswith("agent-ee:"):
            continue
        host, pid = c["HostConfig"], c["State"]["Pid"]
        try:
            pid1 = Path(f"/proc/{pid}/comm").read_text().strip()
        except OSError:
            pid1 = None
        found.append({"name": c["Name"].lstrip("/"), "image": c["Config"]["Image"], "image_id": c["Image"][7:19],
                      "started": c["State"]["StartedAt"][:19] + "Z", "pid1": pid1, "init": bool(host.get("Init")),
                      "cpus": (host.get("NanoCpus") or 0) / 1e9 or None, "pids_limit": host.get("PidsLimit"),
                      "lease": (c["Config"].get("Labels") or {}).get("native-admission.lease") or None})
    return found


def snapshot():
    cfg = config()
    with Mutex():
        leases, extra, used, suites = usage(cfg)
        queue = live("queue")
        res = reservation()
        drain = read_json(HOME / "drain.json")
    zombies, parents = 0, {}
    for stat in Path("/proc").glob("[0-9]*/stat"):
        try:
            fields = stat.read_text().rsplit(")", 1)[1].split()
        except (OSError, IndexError):
            continue
        if fields[0] == "Z":
            zombies += 1
            parents[fields[1]] = parents.get(fields[1], 0) + 1
    top = sorted(parents.items(), key=lambda kv: -kv[1])[:5]
    return {"ts": now(), "host": socket.gethostname(), "nproc": os.cpu_count(),
            "load1": float(Path("/proc/loadavg").read_text().split()[0]),
            "psi_cpu": psi("cpu"), "psi_io": psi("io"), "psi_memory": psi("memory"),
            "budget": cfg["budget"], "max_suites": cfg["max_suites"], "used": used, "suites": suites,
            "leases": [{k: x.get(k) for k in ("id", "label", "weight", "class", "started", "pid")} for x in leases],
            "unleased": extra or [], "queue": [{k: x.get(k) for k in ("label", "weight", "class", "started")} for x in queue],
            "reservation": {k: res.get(k) for k in ("label", "until")} if res else None, "drain": drain or None,
            "capacity_known": extra is not None, "zombies": zombies,
            "zombie_parents": [{"ppid": int(k), "zombies": v} for k, v in top],
            "containers": container_details(cfg),
            "mem_available_mb": next((int(l.split()[1]) // 1024 for l in Path("/proc/meminfo").read_text().splitlines()
                                      if l.startswith("MemAvailable:")), None),
            "root_free_gb": round(os.statvfs("/").f_bavail * os.statvfs("/").f_frsize / 2**30, 1)}


def status(args):
    s = snapshot()
    if args.json:
        print(json.dumps(s, indent=1))
        return
    print(f"{s['host']}: used {s['used']}/{s['budget']}, suites {s['suites']}/{s['max_suites']}, load {s['load1']} "
          f"on {s['nproc']}, PSI cpu {s['psi_cpu']} io {s['psi_io']}, zombies {s['zombies']}")
    if not s["capacity_known"]:
        print("capacity UNKNOWN (docker ps failed): new work queues")
    if s["drain"]:
        print(f"draining ({'suites only' if s['drain'].get('suites_only') else 'all work'}): {s['drain'].get('reason')}")
    if s["reservation"]:
        print(f"reserved for {s['reservation']['label']!r} until {time.ctime(s['reservation']['until'])}")
    for x in s["leases"]:
        print(f"  lease {x['id']} w{x['weight']} {x['class']:5} since {x['started']}  {x['label']}")
    for x in s["unleased"]:
        print(f"  unleased w{x['weight']} {x['class']:5} {x['name']} {x['image']}")
    for i, x in enumerate(s["queue"], 1):
        print(f"  queued #{i} w{x['weight']} {x['class']:5} since {x['started']}  {x['label']}")


def sample(args):
    s = snapshot()
    with open(HOME / "samples.jsonl", "a") as f:
        f.write(json.dumps(s) + "\n")
    if args.print:
        print(json.dumps(s))


def reserve(args):
    token = uuid.uuid4().hex
    with Mutex():
        if reservation():
            sys.exit("native-admit: already reserved")
        (HOME / "reservation.json").write_text(json.dumps(
            {"label": args.label, "token": token, "until": time.time() + args.minutes * 60}))
    log_event("reserved", label=args.label, minutes=args.minutes)
    print(f"export NATIVE_ADMISSION_RESERVATION={token}")


def drain(args):
    with Mutex():
        (HOME / "drain.json").write_text(json.dumps({"reason": args.reason, "suites_only": args.suites_only, "since": now()}))
    log_event("drain", reason=args.reason, suites_only=args.suites_only)


def undrain(_):
    with Mutex():
        (HOME / "drain.json").unlink(missing_ok=True)
    log_event("undrain")


def unreserve(_):
    with Mutex():
        info = reservation()
        (HOME / "reservation.json").unlink(missing_ok=True)
    log_event("unreserved", label=info.get("label"))


def main():
    parser = argparse.ArgumentParser(prog="native-admit", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("run")
    p.add_argument("--weight", type=int)
    p.add_argument("--class", dest="klass", choices=("suite", "test"))
    p.add_argument("--label")
    p.add_argument("--max-wait", type=float)
    p.add_argument("command", nargs=argparse.REMAINDER)
    p.set_defaults(fn=run)
    p = sub.add_parser("status")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=status)
    p = sub.add_parser("sample")
    p.add_argument("--print", action="store_true")
    p.set_defaults(fn=sample)
    p = sub.add_parser("reserve")
    p.add_argument("--label", required=True)
    p.add_argument("--minutes", type=float, required=True)
    p.set_defaults(fn=reserve)
    sub.add_parser("unreserve").set_defaults(fn=unreserve)
    sub.add_parser("verify", help="exit 0 and print the lease id if this process inherited a live lease").set_defaults(fn=verify)
    p = sub.add_parser("drain", help="stop admitting new work (running leases continue)")
    p.add_argument("--reason", required=True)
    p.add_argument("--suites-only", action="store_true")
    p.set_defaults(fn=drain)
    sub.add_parser("undrain").set_defaults(fn=undrain)
    args = parser.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
