#!/usr/bin/env python3
#MISE description="Show host test prerequisites without reading credentials"
#MISE dir="{{cwd}}"
import json
import os
from pathlib import Path
import shutil
import subprocess

tools = {}
for name in ("mise", "python3", "go", "node", "claude", "codex", "agy",
             "native-admit", "systemd-run", "git-wt", "kicad-cli"):
    path = shutil.which(name)
    tools[name] = path
print(json.dumps({"cwd": os.getcwd(), "home": str(Path.home()), "tools": tools,
                  "skills": {name: (Path.home() / path).is_dir() for name, path in {
                      "codex": ".codex/skills", "claude": ".claude/skills",
                      "agy": ".gemini/config/skills"}.items()}}, indent=2), flush=True)
if shutil.which("mise"):
    subprocess.run(["mise", "tasks", "ls"], check=True)
else:
    raise SystemExit("host:doctor: mise is not on PATH; run shared/testing/install.py")
manager = subprocess.run(["systemctl", "--user", "show", "--property=Version", "--value"],
                         capture_output=True, timeout=5)
if manager.returncode:
    raise SystemExit("host:doctor: systemd user manager is unavailable")
